{
  "$comment": "ko-style 저장소 설정 — 검사기는 읽기만 한다. team 의 KO-V-* 는 용어 사전(docs/glossary.md) §3.4 표의 행과 하나씩 대응하고, 사람이 읽는 정본은 그 표다. 이 파일은 검사기가 쓸 활용형과 예외를 더한 사본이다(docs/04-mvp/plugin.md §7).",
  "version": 1,
  "teamSrc": "용어 사전 §3.4",
  "surfaces": [
    {
      "name": "매뉴얼",
      "files": [
        "codebase/apps/web/src/content/manual/ko/*.md"
      ],
      "tone": "hapsyo",
      "dash": "check"
    },
    {
      "name": "화면 문구",
      "files": [
        "codebase/packages/schema/src/i18n/ko.ts"
      ],
      "tone": "off",
      "dash": "check"
    },
    {
      "name": "스킬",
      "files": [
        "codebase/plugin/skills/*/SKILL.md",
        "codebase/plugin/agents/*.md",
        "codebase/plugin/codex/AGENTS.md",
        "codebase/ko-style/skills/*/SKILL.md"
      ],
      "tone": "haera",
      "dash": "off"
    },
    {
      "name": "명세",
      "files": [
        "docs/**/*.md",
        "AGENTS.md",
        "CLAUDE.md",
        "README.md",
        "codebase/**/README.md"
      ],
      "tone": "off",
      "dash": "off"
    }
  ],
  "commit": {
    "tone": "off",
    "dash": "off"
  },
  "reply": {
    "mode": "notify",
    "tone": "off",
    "dash": "check"
  },
  "ignore": [
    "docs/glossary.md",
    "docs/html/**",
    "codebase/ko-style/skills/ko-style/rules/**"
  ],
  "team": [
    {
      "id": "KO-V-01",
      "name": "서다 · 세우다",
      "when": "표시|배지|카드|버튼|경고|라벨|알림|칩|아이콘",
      "avoid": [
        "섭니다",
        "선다",
        "섰다",
        "섰습니다",
        "서고",
        "서 있다",
        "서 있습니다",
        "세운다",
        "세웁니다",
        "세웠다",
        "세웠습니다",
        "세워",
        "세우고",
        "세우는"
      ],
      "use": "나타나다 · 표시되다 · 생기다 / 표시하다 · 띄우다",
      "examples": {
        "bad": [
          "결정이 끝나면 카드에 배지를 세운다.",
          "오류가 나면 경고 표시가 섭니다."
        ],
        "good": [
          "결정이 끝나면 카드에 배지를 표시한다.",
          "오류가 나면 경고가 표시됩니다."
        ]
      }
    },
    {
      "id": "KO-V-02",
      "name": "걷다",
      "when": "기능|코드|신호|필드|칸|값|옵션|분기|경로|스킬|배지|규칙|검사",
      "avoid": [
        "걷는다",
        "걷습니다",
        "걷었다",
        "걷었습니다",
        "걷어",
        "걷어낸다",
        "걷어냈다",
        "걷어냄",
        "걷음",
        "걷고"
      ],
      "use": "없애다 · 제거하다 · 빼다",
      "examples": {
        "bad": [
          "쓰지 않는 신호를 걷는다."
        ],
        "good": [
          "쓰지 않는 신호를 없앤다."
        ]
      }
    },
    {
      "id": "KO-V-03",
      "name": "싣다",
      "avoid": [
        "싣는다",
        "싣습니다",
        "싣고",
        "싣지",
        "싣는",
        "실어",
        "실어서",
        "실어야",
        "실었다",
        "실었습니다",
        "실었고",
        "실린다",
        "실립니다"
      ],
      "use": "담다 · 포함하다 · 넣다",
      "examples": {
        "bad": [
          "응답에 이유를 싣는다.",
          "지문을 실어 다시 부른다."
        ],
        "good": [
          "응답에 이유를 포함한다.",
          "지문을 넣어 다시 부른다."
        ]
      }
    },
    {
      "id": "KO-V-04",
      "name": "배선",
      "pattern": "(?<!전기\\s?)배선",
      "use": "연결 · 구현",
      "examples": {
        "bad": [
          "이벤트를 배선한다."
        ],
        "good": [
          "이벤트를 연결한다.",
          "전기 배선을 점검한다."
        ]
      }
    },
    {
      "id": "KO-V-05",
      "name": "닿다",
      "avoid": [
        "닿는다",
        "닿습니다",
        "닿지",
        "닿아",
        "닿았다",
        "닿았습니다",
        "닿는",
        "닿을"
      ],
      "use": "이어지다 · 적용되다 · 전달되다",
      "examples": {
        "bad": [
          "신고가 제출에 닿는다."
        ],
        "good": [
          "신고가 다음 제출에 적용된다."
        ]
      }
    },
    {
      "id": "KO-V-06",
      "name": "가르다",
      "avoid": [
        "가른다",
        "가릅니다",
        "가르는",
        "갈랐다",
        "갈랐습니다",
        "가르고",
        "가르지"
      ],
      "use": "나누다 · 구분하다",
      "examples": {
        "bad": [
          "두 경우를 가른다."
        ],
        "good": [
          "두 경우를 나눈다."
        ]
      }
    },
    {
      "id": "KO-V-07",
      "name": "짚다 (검사가)",
      "when": "검사|테스트|리뷰|CI|게이트|린트|L1|L2|L3",
      "avoid": [
        "짚었다",
        "짚었습니다",
        "짚는다",
        "짚습니다",
        "짚어",
        "짚은"
      ],
      "use": "잡아내다 · 지적하다",
      "examples": {
        "bad": [
          "검사가 그 결함을 짚었다."
        ],
        "good": [
          "검사가 그 결함을 잡아냈다."
        ]
      }
    },
    {
      "id": "KO-V-08",
      "name": "쥐다",
      "avoid": [
        "쥔",
        "쥐고",
        "쥡니다",
        "쥐었다",
        "쥐었습니다",
        "쥐는",
        "쥐어"
      ],
      "use": "맡다 · 가지다 · (작업을) 잡다",
      "examples": {
        "bad": [
          "세션이 쥔 작업을 넘긴다.",
          "클레임을 이미 쥐고 있다."
        ],
        "good": [
          "세션이 맡은 작업을 넘긴다.",
          "클레임을 이미 가지고 있다."
        ]
      }
    },
    {
      "id": "KO-V-09",
      "name": "머리 (화면 · 문서 · 카드의)",
      "pattern": "(?:문서|카드|화면|표|페이지|절|파일|응답|목록|패널|섹션)(?:의)?\\s?머리(?!말|글|카락|털|띠)",
      "use": "상단 · 제목 줄 · 헤더",
      "examples": {
        "bad": [
          "문서 머리에 버전을 적는다."
        ],
        "good": [
          "문서 상단에 버전을 적는다.",
          "머리말에 버전을 적는다."
        ]
      }
    },
    {
      "id": "KO-V-10",
      "name": "말하다 (화면 · 문서 · 서버가)",
      "pattern": "(?:화면|서버|문서|카드|배지|응답|표|절)(?:이|가|은|는)\\s(?:(?:(?!(?:면|고|서|니|며|때|데)\\s)[^.!?\\n—,]){0,24}?\\s)?(?:말한다|말합니다|말해\\s?준다|말해\\s?줍니다)",
      "use": "보여 주다 · 알려 주다 · 적혀 있다",
      "examples": {
        "bad": [
          "카드가 결정 이유를 말합니다."
        ],
        "good": [
          "카드에 결정 이유가 적혀 있습니다.",
          "문서가 있으면 그 표를 옮길지 말합니다."
        ]
      }
    },
    {
      "id": "KO-V-11",
      "name": "들고 있다 (결정을)",
      "pattern": "(?:결정|값|상태|요청|변경)(?:을|를)\\s(?:[^.!?\\n—,]{0,12}?\\s)?들고\\s?있",
      "use": "보류하다 · 기다렸다가 보내다",
      "examples": {
        "bad": [
          "카드가 결정을 5초 들고 있다."
        ],
        "good": [
          "카드가 결정을 5초 동안 보류한다."
        ]
      }
    },
    {
      "id": "KO-V-12",
      "name": "무르다",
      "avoid": [
        "무른다",
        "무릅니다",
        "물렀다",
        "물렀습니다",
        "무르는",
        "무르고",
        "무르지"
      ],
      "use": "취소하다",
      "examples": {
        "bad": [
          "결정을 무른다."
        ],
        "good": [
          "결정을 취소한다."
        ]
      }
    },
    {
      "id": "KO-V-13",
      "name": "곁에",
      "pattern": "곁(?:에|의|으로)",
      "use": "옆에",
      "examples": {
        "bad": [
          "배지 곁에 숫자를 둔다."
        ],
        "good": [
          "배지 옆에 숫자를 둔다."
        ]
      }
    },
    {
      "id": "KO-V-14",
      "name": "길 · 문 (방법 · 경로의 비유)",
      "pattern": "(?:바로잡는|들어가는|고치는|되돌리는|나가는|돌아가는|여는)\\s(?:길|문)(?:이|을|은|으로|도|과)?(?![가-힣])",
      "use": "방법 · 경로",
      "examples": {
        "bad": [
          "결정을 바로잡는 길을 만든다."
        ],
        "good": [
          "결정을 바로잡는 방법을 만든다."
        ]
      }
    },
    {
      "id": "KO-V-15",
      "name": "옮겨 적다 (값을)",
      "pattern": "옮겨\\s?적(?:는다|습니다|었다|었습니다|어|고|은|는)",
      "use": "그대로 기록하다 · 복사하다",
      "examples": {
        "bad": [
          "판정을 옮겨 적는다."
        ],
        "good": [
          "판정을 그대로 기록한다."
        ]
      }
    },
    {
      "id": "KO-H-01",
      "name": "\"~하는 것이다\" (문장 습관)",
      "pattern": "(?<=[가-힣])는\\s것이다(?=[.!?]|$)",
      "use": "문장을 바로 끝낸다",
      "examples": {
        "bad": [
          "중요한 것은 테스트를 먼저 쓰는 것이다."
        ],
        "good": [
          "테스트를 먼저 쓴다."
        ]
      }
    }
  ]
}
