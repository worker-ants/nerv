# NERV 로컬/자가호스팅 환경변수 — 정본: docs/04-mvp/codebase.md §5.2 전표
#
#   cp .env.example .env
#
# 필수 3개(POSTGRES_PASSWORD · MINIO_ROOT_PASSWORD · NERV_AUTH_SECRET)만 채우면 기동된다.
# 나머지는 전부 기본값으로 동작한다.
#
# **적힌 값은 compose 경로 기준이다**(부트스트랩은 4.2 §5.1). 개발 루프(`pnpm dev`)에서
# 달라지는 자리는 그 구역의 `개발 루프:` 줄이 적는다 — 두 경로는 위상이 다르다(구역 ①).
#
# 구역 여덟
#   ① 공개 주소·포트·세션        ⑤ 워커·잡 루프
#   ② Postgres                   ⑥ 오브젝트 스토리지 (MinIO · S3)
#   ③ Valkey · 실시간            ⑦ 외부 연동 (GitHub 웹훅 · md 미러)
#   ④ 임베딩 제공자              ⑧ 이미지·로그
#
# 에이전트 장비 쪽 변수(NERV_TOKEN · NERV_PROJECT · NERV_HOSTNAME)는 이 전표가 아니다 —
# 정본은 docs/03-proposal/agent-integration.md §3.3·§4.1, 설치 절차는 docs/04-mvp/plugin.md.

# ── ① 공개 주소·포트·세션 ───────────────────────────────────────────────────
#
# **아래 넷이 다 8080 인 것은 우연이다** — 층이 셋으로 다르고, 경로마다 듣는 것이 다르다.
# 한 숫자를 세 뜻으로 읽다가 혼선이 생기는 자리라 여기 한데 모았다.
#
#   compose 경로(`pnpm compose:up`) — 앞문 하나가 화면과 API 를 함께 서빙한다
#     브라우저 ──→ localhost:8080 ──→ [web · nginx :80] ──→ [api :8080]
#                  └ NERV_HTTP_PORT    앞문(호스트 공개)     컨테이너 안 — 호스트에 안 열린다
#                  └ 공개 주소 둘이 가리키는 곳이 바로 이 앞문이다
#
#   개발 루프(`pnpm dev`) — 앞문이 없다. 화면과 API 가 **다른 오리진**에 따로 뜬다
#     브라우저 ──→ localhost:5173 ──/api·/mcp·/ws·/sse·/ingest→ localhost:8080
#                  └ Vite(화면이 사는 곳)        Vite dev 프록시    └ NERV_API_PORT
#
#   NERV_HTTP_PORT — compose 앞문의 **호스트** 공개 포트(컨테이너 :80 을 내보낸다).
#                    개발 루프에는 없는 개념이다 — 앞문 자체가 없다.
#   NERV_API_PORT  — API **프로세스**가 리슨하는 포트.
#   NERV_WEB_URL   — **사람이 브라우저로 여는 주소.** 스펙 딥링크가 이것으로 절대 URL 이 된다.
#   NERV_API_URL   — **프로그램이 붙는 주소.** 세션 쿠키 baseURL · 플러그인 카탈로그 ·
#                    `/api/auth/*` 절대화 기준 · `/mcp` Origin 대조 대상 둘 중 하나.
#
# 공개 주소 둘은 경로 없는 오리진만 적고, **앞문을 가리킨다**(API 프로세스 포트가 아니다) —
# compose 에서 NERV_HTTP_PORT 를 바꾸면 두 주소의 포트도 함께 바꾼다. NERV_API_PORT 를
# 따라가지 않는다.
#
# 옛 이름 NERV_PUBLIC_URL 은 걷혔다 — 그것만 설정돼 있으면 **서버가 기동을 거부한다**(REQ-CB-037).
NERV_HTTP_PORT=8080
# compose 는 이 값을 `.env` 에서 읽지 않는다 — api 서비스에 "8080" 으로 박혀 있고 앞문
# (NERV_API_UPSTREAM=api:8080)과 헬스체크도 그 포트를 본다. **개발 루프에서만 듣는 손잡이인데
# 거기서도 바꾸면 조용히 깨진다**: apps/web/vite.config.ts 의 프록시 대상이 localhost:8080 로
# 박혀 있고, 공개 주소의 기본값(apps/api/src/common/origins.ts DEFAULT_ORIGIN)도 그 값이다.
NERV_API_PORT=8080
NERV_WEB_URL=http://localhost:8080
NERV_API_URL=http://localhost:8080
# 개발 루프: 화면은 Vite(:5173)에 뜨고 API 는 :8080 이라 **두 주소가 실제로 갈린다** —
# 이름을 가른 이유가 그대로 보이는 자리다(REQ-CB-036). NERV_WEB_URL 을 :5173 으로 바꾼다.
# 그대로 두면 에이전트가 붙여 주는 스펙 딥링크가 :8080 을 가리키는데, 개발 루프의 :8080 은
# 화면을 서빙하지 않는 API 라 그 링크가 404 다(API 는 SPA 를 서빙하지 않는다 — 앞문의 몫이다).
#   NERV_WEB_URL=http://localhost:5173
#
# baseURL(=NERV_API_URL) 밖에서 화면을 띄울 때만 추가한다 — CSRF 방어선이라 코드 기본값은
# 비움이다. 아래 값이 채워져 있는 것은 **개발 루프 때문이다**: 화면이 :5173, API 가 :8080 이라
# 프록시를 거쳐도 Origin 은 :5173 로 남아, 비우면 로그인이 INVALID_ORIGIN 으로 막힌다.
# compose 는 앞문 하나라 오리진이 같아 **필요 없다** — 그 배치는 비우는 편이 좁다.
# 구분자는 **쉼표·공백·줄바꿈** 셋 다다(k8s ConfigMap 의 여러 줄 문자열이 자연스러운 모양이라).
# 값은 **경로 없는 오리진**으로 정규화된다 — 끝 슬래시·경로가 붙으면 오리진만 남기고 한 줄
# 남긴다. **스킴을 빠뜨리면 그 값은 버려진다**(`localhost:5173` 의 오리진은 문자열 "null" 이라
# 그대로 두면 Origin: null 요청이 통과한다). 버린 사실도 기동 로그가 말한다.
NERV_TRUSTED_ORIGINS=http://localhost:5173
# 필수 — openssl rand -base64 32
NERV_AUTH_SECRET=

# ── ② Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=nerv
# 필수
POSTGRES_PASSWORD=
POSTGRES_DB=nerv
# compose 포트 노출(127.0.0.1 한정) — 개발 루프용
POSTGRES_PORT=5432
# 개발 루프(pnpm dev)에서만 필요. compose 내부에서는 postgres 호스트로 자동 조립된다.
DATABASE_URL=postgres://nerv:CHANGEME@localhost:5432/nerv

# ── ③ Valkey · 실시간 ───────────────────────────────────────────────────────
# compose 포트 노출(127.0.0.1 한정) — 개발 루프용
VALKEY_PORT=6379
# 실시간 방송 MQ(nerv_events pub/sub). Valkey 는 RESP 프로토콜이라 redis:// 스킴.
# compose 내부는 redis://valkey:6379
NERV_VALKEY_URL=redis://localhost:6379
# SSE keep-alive 주기(ms) — 앞문의 유휴 타임아웃이 이 값보다 짧으면 스트림이 조용히 끊긴다.
# 비우면 25000. 형식은 `event: ping` · `data: {}` 메시지다(코멘트 라인이 아니다 — §3.5).
NERV_SSE_KEEPALIVE_MS=25000

# ── ④ 임베딩 제공자 (OpenAI 호환 /v1/embeddings 단일 계약 — §5.2a) ──────────
# 프로필은 아래 3종. 코드는 제공자를 모른다 — 이 3키만 바꾼다(REQ-CB-020).
#   로컬(기본값) : NERV_EMBED_URL=http://embed:11434/v1           MODEL=bge-m3                 KEY 불요
#                  compose 는 --profile local-embed 로 embed 서비스를 함께 띄운다(ollama — amd64·arm64)
#   스테이징     : NERV_EMBED_URL=http://<lmstudio-host>:1234/v1  MODEL=bge-m3 계열(GGUF)
#   운영         : NERV_EMBED_URL=https://api.openai.com/v1       MODEL=text-embedding-3-small  KEY 필수
#                  운영 OpenAI 는 NERV_EMBED_SEND_DIMENSIONS=true 가 **필수**다(Matryoshka 절단)
# 차원은 전 프로필 1024 고정이며, 프로필 전환은 전량 재임베딩이다(벡터 공간이 다르다).
NERV_EMBED_URL=http://localhost:8090/v1
NERV_EMBED_MODEL=bge-m3
# 외부 제공자 사용 시 필수 — secret
NERV_EMBED_API_KEY=
# 요청에 dimensions 를 실을 것인가 — 1024 를 그대로 내는 모델(bge-m3)은 false, 절단이 필요한
# 모델(text-embedding-3-*)은 **true**. 2026-09-07 까지 주소에 api.openai.com 이 있는지로
# 추정했는데, 게이트웨이(Azure·LiteLLM·사내) 뒤의 같은 모델은 그 주소가 아니라 1536 차원이
# 돌아왔고 검색은 조용히 렉시컬로 degrade 했다(REQ-CB-033).
NERV_EMBED_SEND_DIMENSIONS=false
# compose 포트 노출(127.0.0.1 한정) — 로컬 프로필 전용
NERV_EMBED_PORT=8090
# 한 요청의 예산 둘 — 실측에서 나온 값이다(codebase.md §5.2b). 로컬 CPU 프로필에서 지연은
# 입력 개수가 아니라 총 문자 수를 따라간다(4,000자 5.5초 · 16,000자 39.8초). 빠른 제공자
# (OpenAI)는 NERV_EMBED_BATCH_CHARS 를 올려 왕복을 줄이면 된다.
NERV_EMBED_TIMEOUT_MS=30000
NERV_EMBED_BATCH_CHARS=6000

# ── ⑤ 워커·잡 루프 ─────────────────────────────────────────────────────────
# 제공자 예산(④)이 아니라 **루프가 시간을 어떻게 나누는가**다(§5.2b).
# 임베딩 한 판의 시간 상한 — 비싼 잡이 급한 잡(리스 회수·stale)을 굶기지 않게 한다.
NERV_EMBED_PASS_MS=20000
# 일감이 있을 때의 임베딩 주기. 없으면 5분으로 스스로 물러난다.
NERV_EMBED_EVERY_MS=1000
# 잡 루프의 틱 해상도 — 잡이 1초 주기를 원해도 틱이 성기면 그 간격으로 발화한다.
NERV_WORKER_TICK_MS=1000

# ── ⑥ 오브젝트 스토리지 (MinIO · S3 호환) ───────────────────────────────────
MINIO_ROOT_USER=nerv
# 필수
MINIO_ROOT_PASSWORD=
# compose 포트 노출(127.0.0.1 한정) — 개발 루프용
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# 서버가 S3 에 붙는 주소. compose 내부는 http://minio:9000
NERV_S3_ENDPOINT=http://localhost:9000
# **앱이 읽는 자격증명은 이 둘이다**(MINIO_ROOT_* 는 compose 가 MinIO 에 주는 값이고,
# 로컬 프로세스(`pnpm dev`)에는 조립해 주는 사람이 없어 첨부가 조용히 꺼져 있었다)
NERV_S3_ACCESS_KEY=nerv
NERV_S3_SECRET_KEY=
# 에이전트가 받는 presigned PUT 주소는 **밖에서 열려야 한다** — 서버가 붙는 내부 주소로
# 서명하면 개발자 장비에서 그 호스트를 해소하지 못한다. 여기에 공개 주소를 적는다.
# **경로 접두(`/s3`)는 안 된다**(REQ-CB-034): presigned 서명이 경로를 포함하므로 앞문이 접두를
# 벗기면 SignatureDoesNotMatch 이고, 벗기지 않으면 MinIO 가 접두 아래에서 S3 API 를 서빙하지
# 않는다. 앞문 밖의 **별도 호스트**를 적는다(예 https://s3.nerv.example.com).
# 구역 ① 의 공개 주소 둘과 같은 부류의 손잡이이고, 이 저장소가 먼저 데인 자리다.
NERV_S3_PUBLIC_ENDPOINT=http://localhost:9000
# api 가 기동 시 없으면 생성한다
NERV_S3_BUCKET=nerv-blobs
# 서명에 들어가는 리전 — MinIO 는 아무 값이나 받지만 **실제 S3·R2·GCS 호환은 이 값으로
# 서명을 검증**하므로 틀리면 SignatureDoesNotMatch 다. 비우면 us-east-1.
NERV_S3_REGION=us-east-1
NERV_S3_FORCE_PATH_STYLE=true

# ── ⑦ 외부 연동 ────────────────────────────────────────────────────────────
# GitHub 웹훅 서명 검증(EP-WHK-01) — 비면 모든 웹훅이 401 이다
NERV_GITHUB_WEBHOOK_SECRET=
# md 미러 산출 위치(export 잡) — 비면 미러를 만들지 않는다
# NERV_EXPORT_DIR=./.nerv/mirror

# ── ⑧ 이미지·로그 ──────────────────────────────────────────────────────────
# compose 이미지 태그. 운영 태깅은 §6.4(git SHA)
NERV_TAG=dev
NERV_LOG_LEVEL=info
