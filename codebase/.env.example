# NERV 로컬/자가호스팅 환경변수 — 전표 정본: docs/04-mvp/codebase.md §5.2
#
#   cp .env.example .env
#
# 필수 3개(POSTGRES_PASSWORD · MINIO_ROOT_PASSWORD · NERV_AUTH_SECRET)만 채우면 기동된다.
# 값은 compose 경로 기준이고, 개발 루프(pnpm dev)에서 달라지는 자리는 `개발 루프:` 로 적었다.
# **여기는 무엇을 넣는지만 적는다** — 왜 그런지와 무엇이 딸려 오는지는 전표가 적는다.
#
# 구역  ① 주소·포트·세션  ② Postgres  ③ Valkey·실시간  ④ 임베딩
#       ⑤ 워커·잡 루프    ⑥ 오브젝트 스토리지  ⑦ 외부 연동  ⑧ 이미지·로그
#
# 에이전트 장비 쪽(NERV_TOKEN · NERV_PROJECT · NERV_HOSTNAME)은 이 전표가 아니다 —
# docs/03-proposal/agent-integration.md §3.3·§4.1, 설치는 docs/04-mvp/plugin.md.

# ── ① 주소·포트·세션 ────────────────────────────────────────────────────────
#
# 넷이 다 8080 인 것은 우연이다 — 층이 셋이고 경로마다 듣는 것이 다르다.
#   NERV_WEB_PORT   앞문(nginx)이 **리슨하는** 포트이고 compose 가 호스트에 내보내는 포트다.
#                   개발 루프에서는 Vite 가 이 포트에 뜬다.
#   NERV_API_PORT   api 프로세스가 리슨하는 포트. 업스트림·헬스체크가 같은 값을 쓴다.
#   NERV_WEB_URL    사람이 브라우저로 여는 주소 — 스펙 딥링크가 이것으로 절대 URL 이 된다.
#   NERV_API_URL    프로그램이 붙는 주소 — 세션 쿠키 baseURL · 플러그인 카탈로그 · /mcp Origin.
# 공개 오리진 둘은 경로 없는 오리진만 적고 **앞문**을 가리킨다 — NERV_WEB_PORT 를 바꾸면
# 두 주소의 포트도 함께 바꾼다(NERV_API_PORT 를 따라가지 않는다).
NERV_WEB_PORT=8080
NERV_API_PORT=8080
# 개발 루프: NERV_WEB_PORT=5173 — 화면은 Vite 에, API 는 :8080 에 따로 뜬다. compose 값(8080)을
# 그대로 두고 `pnpm dev` 를 돌리면 Vite 가 api 와 같은 포트를 잡으므로 런처가 먼저 멈춘다.

# 개발 루프: NERV_WEB_URL=http://localhost:5173 — 화면이 Vite 에 뜨고, :8080 은 화면을
# 서빙하지 않는 API 라 그대로 두면 스펙 딥링크가 404 다.
NERV_WEB_URL=http://localhost:8080
NERV_API_URL=http://localhost:8080
# 걷힌 이름 둘 — 설정돼 있고 새 이름이 비면 서버가 기동을 거부한다(REQ-CB-037 · 039).
#   NERV_PUBLIC_URL → NERV_WEB_URL · NERV_API_URL
#   NERV_HTTP_PORT  → NERV_WEB_PORT (컨테이너 안팎이 같은 포트다)

# 화면 주소(NERV_WEB_URL) **밖에서** 화면을 띄울 때만 추가한다 — CSRF 방어선이라 기본은 비움이다.
# 허용 오리진은 NERV_WEB_URL + 이 목록의 합집합이고, CORS 와 better-auth 가 **같은 목록**을
# 본다(REQ-CB-041). 구분자는 쉼표·공백·줄바꿈 셋 다이고, 값은 경로 없는 오리진으로
# 정규화되며 스킴을 빠뜨린 값은 버려진다(무엇을 어떻게 읽었는지 기동 로그가 말한다).
# 아래 값은 **개발 루프용**이다 — 화면이 Vite(:5173)에 뜨므로 Origin 이 그 주소다.
# NERV_WEB_URL 을 :5173 으로 옮긴 배치에서는 같은 값이 두 번 든 셈이라 지워도 된다
# (목록은 중복을 한 번만 남긴다). compose 는 앞문 하나라 오리진이 같아 필요 없다.
NERV_TRUSTED_ORIGINS=http://localhost:5173
# 세션 쿠키를 한 호스트보다 **넓게** 둘 때만 적는다 — 두 주소의 공통 상위 도메인이어야 하고,
# 아니면 기동을 거부한다(REQ-CB-042). 비우면 호스트 전용 쿠키이고 그것이 기본이다:
# 화면과 API 가 같은 등록 도메인 아래의 서브도메인 둘이면 비운 채로 동작한다.
# 넓히면 그 도메인 아래 **모든 호스트**가 세션 쿠키를 받는다 — 신뢰하지 않는 호스트를
# 그 아래 두지 않는다는 운영 약속이 함께 간다(4.1 §2.3).
NERV_COOKIE_DOMAIN=
# 필수 — openssl rand -base64 32
NERV_AUTH_SECRET=

# ── ② Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=nerv
# 필수
POSTGRES_PASSWORD=
POSTGRES_DB=nerv
# compose 포트 노출(127.0.0.1 한정) — 개발 루프용
POSTGRES_PORT=5432
# 개발 루프 전용 — compose 내부에서는 postgres 호스트로 자동 조립된다.
DATABASE_URL=postgres://nerv:CHANGEME@localhost:5432/nerv

# ── ③ Valkey · 실시간 ───────────────────────────────────────────────────────
# compose 포트 노출(127.0.0.1 한정) — 개발 루프용
VALKEY_PORT=6379
# 실시간 방송 MQ(nerv_events pub/sub). RESP 프로토콜이라 redis:// 스킴.
# compose 내부는 redis://valkey:6379
NERV_VALKEY_URL=redis://localhost:6379
# SSE keep-alive 주기(ms) — 앞문의 유휴 타임아웃이 이 값보다 짧으면 스트림이 조용히 끊긴다.
NERV_SSE_KEEPALIVE_MS=25000

# ── ④ 임베딩 제공자 (OpenAI 호환 /v1/embeddings · 프로필은 §5.2a) ───────────
# 코드는 제공자를 모른다 — 아래 3키만 바꾼다(REQ-CB-020). 차원은 전 프로필 1024 고정이고,
# 프로필을 바꾸면 벡터 공간이 달라 전량 재임베딩이다.
#   로컬(기본)  http://embed:11434/v1      bge-m3                  KEY 불요
#               compose 는 --profile local-embed 로 embed 서비스를 함께 띄운다
#   스테이징    http://<lmstudio>:1234/v1  bge-m3 계열(GGUF)
#   운영        https://api.openai.com/v1  text-embedding-3-small  KEY 필수 · DIMENSIONS 필수
NERV_EMBED_URL=http://localhost:8090/v1
NERV_EMBED_MODEL=bge-m3
# 외부 제공자 사용 시 필수 — secret
NERV_EMBED_API_KEY=
# 1024 를 그대로 내는 모델(bge-m3)은 false, 절단이 필요한 모델(text-embedding-3-*)은 true.
# 주소로 추정하지 않는다 — 게이트웨이 뒤의 같은 모델이 1536 을 돌려주면 검색이 조용히
# 렉시컬로 degrade 한다(REQ-CB-033).
NERV_EMBED_SEND_DIMENSIONS=false
# MRL(Matryoshka) 모델의 긴 벡터를 받는 쪽에서 잘라 맞춘다 — 모델 카드를 보고 켠다(§5.2a)
NERV_EMBED_TRUNCATE=false
# compose 포트 노출(127.0.0.1 한정) — 로컬 프로필 전용
NERV_EMBED_PORT=8090
# 한 요청의 예산 둘 — 지연은 입력 개수가 아니라 총 문자 수를 따라간다(§5.2b).
# 빠른 제공자는 BATCH_CHARS 를 올려 왕복을 줄인다.
NERV_EMBED_TIMEOUT_MS=30000
NERV_EMBED_BATCH_CHARS=6000

# ── ⑤ 워커·잡 루프 ─────────────────────────────────────────────────────────
# 임베딩 한 판의 시간 상한 — 비싼 잡이 급한 잡(리스 회수·stale)을 굶기지 않게 한다.
NERV_EMBED_PASS_MS=20000
# 일감이 있을 때의 임베딩 주기. 없으면 5분으로 스스로 물러난다.
NERV_EMBED_EVERY_MS=1000
# 잡 루프의 틱 해상도 — 잡이 1초 주기를 원해도 틱이 성기면 그 간격으로 발화한다.
NERV_WORKER_TICK_MS=1000

# ── ⑥ 오브젝트 스토리지 (MinIO · S3 호환) ───────────────────────────────────
MINIO_ROOT_USER=nerv
# 필수
MINIO_ROOT_PASSWORD=
# compose 포트 노출(127.0.0.1 한정) — 개발 루프용
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# 서버가 S3 에 붙는 주소. compose 내부는 http://minio:9000
NERV_S3_ENDPOINT=http://localhost:9000
# **앱이 읽는 자격증명은 이 둘이다** — MINIO_ROOT_* 는 compose 가 MinIO 에 주는 값이라
# 로컬 프로세스(pnpm dev)에는 조립해 주는 주체가 없다.
NERV_S3_ACCESS_KEY=nerv
NERV_S3_SECRET_KEY=
# 에이전트가 받는 presigned PUT 주소 — **밖에서 열려야 한다.** 앞문 밖의 별도 호스트를
# 적는다(예 https://s3.nerv.example.com). **경로 접두(/s3)는 안 된다** — 서명이 경로를
# 포함하므로 앞문이 접두를 벗기면 SignatureDoesNotMatch 다(REQ-CB-034).
NERV_S3_PUBLIC_ENDPOINT=http://localhost:9000
# api 가 기동 시 없으면 생성한다
NERV_S3_BUCKET=nerv-blobs
# 서명에 들어간다 — MinIO 는 아무 값이나 받지만 실제 S3·R2 는 이 값으로 검증한다.
NERV_S3_REGION=us-east-1
# minio 호환
NERV_S3_FORCE_PATH_STYLE=true

# ── ⑦ 외부 연동 ────────────────────────────────────────────────────────────
# GitHub 웹훅 서명 검증(EP-WHK-01) — 비면 모든 웹훅이 401 이다
NERV_GITHUB_WEBHOOK_SECRET=
# md 미러 산출 위치(export 잡) — 비면 미러를 만들지 않는다
# NERV_EXPORT_DIR=./.nerv/mirror

# ── ⑦b 메일 ────────────────────────────────────────────────────────────────
# **비면 메일을 보내지 않는다** — 아웃박스에 쌓지도 않는다(보낼 수 없는 줄이 조용히 자라면,
# SMTP 를 켠 날 몇 달 치가 한꺼번에 나간다). 개발 루프는 compose 의 mailpit 을 가리킨다.
# 예(운영): smtps://user:pass@smtp.example.com:465
NERV_SMTP_URL=smtp://mailpit:1025
# 보내는 사람. SMTP 를 켜 놓고 비우면 **기동을 거부한다**(보내는 사람 없는 메일은 거절되거나
# 스팸함으로 간다 — "보냈다고 믿는데 닿지 않는" 모양이다)
NERV_MAIL_FROM=NERV <no-reply@nerv.example.com>
# 사람이 답장할 주소. no-reply 로만 두면 "이 메일 뭐죠" 가 갈 곳이 없다
# NERV_MAIL_REPLY_TO=
# 아웃박스는 쌓고 보내지는 않는다 — 첫 배포에서 무엇이 나갈지 먼저 본다
NERV_MAIL_DRY_RUN=false
# 가입 이메일 인증을 강제할 것인가. **비우면 위 SMTP 에서 유도한다** — 메일이 있는 배치는
# 강제이고, 없는 배치는 애초에 인증 메일을 보낼 수 없어 강제할 수도 없다.
# true 로 켜 놓고 SMTP 를 비우면 **기동을 거부한다**(아무도 가입하지 못하는 서버가 된다)
# NERV_REQUIRE_EMAIL_VERIFICATION=

# ── ⑧ 이미지·로그 ──────────────────────────────────────────────────────────
# compose 이미지 태그. 운영 태깅은 §6.4(git SHA)
NERV_TAG=dev
# verbose · debug · log(=info) · warn · error · fatal — 고른 수준과 그보다 심각한 것을 켠다
NERV_LOG_LEVEL=info
