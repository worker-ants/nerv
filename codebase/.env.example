# NERV 로컬·자가호스팅 환경변수. 변수 전표 정본은 docs/04-mvp/codebase.md §5.2
#
#   cp .env.example .env
#
# 필수 3개(POSTGRES_PASSWORD · MINIO_ROOT_PASSWORD · NERV_AUTH_SECRET)만 채우면 기동한다.
# 값은 compose 기준이고, 개발 루프(pnpm dev)에서 달라지는 자리는 "개발 루프:" 로 적었다.
# 여기에는 무엇을 넣는지만 적는다. 왜 그런지와 무엇이 함께 바뀌는지는 전표에 있다.
#
# 구역  ① 주소·포트·세션  ② Postgres  ③ Valkey·실시간  ④ 임베딩
#       ⑤ 워커·잡 루프    ⑥ 오브젝트 스토리지  ⑦ 외부 연동  ⑧ 이미지·로그
#
# 에이전트 장비 쪽(NERV_TOKEN · NERV_PROJECT · NERV_HOSTNAME)은 이 파일이 아니다.
# docs/03-proposal/agent-integration.md §3.3·§4.1, 설치는 docs/04-mvp/plugin.md.

# ── ① 주소·포트·세션 ────────────────────────────────────────────────────────
#
# 네 값이 다 8080이지만 뜻은 다르다.
#   NERV_WEB_PORT   앞문(nginx)이 리슨하는 포트. compose가 호스트에 같은 번호로 내보낸다.
#                   개발 루프에서는 Vite가 이 포트를 쓴다.
#   NERV_API_PORT   api 프로세스가 리슨하는 포트. 업스트림과 헬스체크가 같은 값을 쓴다.
#   NERV_WEB_URL    사람이 브라우저로 여는 주소. 스펙 딥링크의 절대 URL이 여기서 나온다.
#   NERV_API_URL    프로그램이 붙는 주소. 세션 쿠키 baseURL · 플러그인 카탈로그 · /mcp Origin.
# 공개 오리진 둘은 경로 없는 오리진만 적고 앞문을 가리킨다. NERV_WEB_PORT를 바꾸면 두 주소의
# 포트도 함께 바꾼다(NERV_API_PORT와는 무관하다).
NERV_WEB_PORT=8080
NERV_API_PORT=8080
# 개발 루프: NERV_WEB_PORT=5173. 화면은 Vite에, API는 :8080에 따로 띄운다. compose 값(8080)을
# 그대로 두고 pnpm dev를 돌리면 Vite가 api와 같은 포트를 잡아 런처가 먼저 멈춘다.

# 개발 루프: NERV_WEB_URL=http://localhost:5173. 화면은 Vite에 뜨고 :8080은 화면을 서빙하지
# 않는 API라, 그대로 두면 스펙 딥링크가 404다.
NERV_WEB_URL=http://localhost:8080
NERV_API_URL=http://localhost:8080
# 지금은 쓰지 않는 이름 둘. 설정돼 있고 새 이름이 비면 서버가 기동을 거부한다(REQ-CB-037 · 039).
#   NERV_PUBLIC_URL → NERV_WEB_URL · NERV_API_URL
#   NERV_HTTP_PORT  → NERV_WEB_PORT (컨테이너 안팎이 같은 포트다)

# 화면 주소(NERV_WEB_URL) 밖에서 화면을 띄울 때만 추가한다. CSRF 방어선이라 기본은 비움이다.
# 허용 오리진은 NERV_WEB_URL과 이 목록의 합집합이고, CORS와 better-auth가 같은 목록을
# 본다(REQ-CB-041). 구분자는 쉼표·공백·줄바꿈 셋 다이고, 값은 경로 없는 오리진으로
# 정규화한다. 스킴을 빠뜨린 값은 버린다. 무엇을 어떻게 읽었는지는 기동 로그에 남는다.
# 아래 값은 개발 루프용이다. 화면이 Vite(:5173)에 떠서 Origin이 그 주소다.
# NERV_WEB_URL을 :5173으로 옮긴 배치에서는 지워도 된다(목록은 중복을 한 번만 남긴다).
# compose는 앞문 하나라 오리진이 같아 필요 없다.
NERV_TRUSTED_ORIGINS=http://localhost:5173
# 세션 쿠키를 한 호스트보다 넓게 둘 때만 적는다. 두 공개 주소의 공통 상위 도메인이어야 하고,
# 아니면 기동을 거부한다(REQ-CB-042). 비우면 호스트 전용 쿠키이고 그것이 기본이다. 화면과
# API가 같은 등록 도메인 아래의 서브도메인 둘이면 비운 채로 동작한다. 넓히면 그 도메인 아래
# 모든 호스트가 세션 쿠키를 받으므로, 믿지 않는 호스트를 그 아래 두지 않아야 한다(4.1 §2.3).
NERV_COOKIE_DOMAIN=
# 필수. openssl rand -base64 32 로 만든다
NERV_AUTH_SECRET=

# ── ② Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=nerv
# 필수
POSTGRES_PASSWORD=
POSTGRES_DB=nerv
# compose 포트 노출(127.0.0.1 한정). 개발 루프용
POSTGRES_PORT=5432
# 개발 루프 전용. compose 안에서는 postgres 호스트로 자동 조립한다
DATABASE_URL=postgres://nerv:CHANGEME@localhost:5432/nerv

# ── ③ Valkey · 실시간 ───────────────────────────────────────────────────────
# compose 포트 노출(127.0.0.1 한정). 개발 루프용
VALKEY_PORT=6379
# 실시간 방송 MQ(nerv_events pub/sub). RESP 프로토콜이라 redis:// 스킴을 쓴다.
# compose 안에서는 redis://valkey:6379
NERV_VALKEY_URL=redis://localhost:6379
# SSE keep-alive 주기(ms). 앞문의 유휴 타임아웃이 이 값보다 짧으면 스트림이 조용히 끊긴다
NERV_SSE_KEEPALIVE_MS=25000

# ── ④ 임베딩 제공자 (OpenAI 호환 /v1/embeddings · 프로필은 §5.2a) ───────────
# 제공자를 바꿀 때 고치는 것은 아래 3키다(REQ-CB-020). 차원은 전 프로필 1024 고정이고,
# 프로필을 바꾸면 벡터 공간이 달라져 전량 재임베딩이다.
#   로컬(기본)  http://embed:11434/v1      bge-m3                  KEY 불요
#               compose는 --profile local-embed 로 embed 서비스를 함께 띄운다
#   스테이징    http://<lmstudio>:1234/v1  bge-m3 계열(GGUF)
#   운영        https://api.openai.com/v1  text-embedding-3-small  KEY 필수 · DIMENSIONS 필수
NERV_EMBED_URL=http://localhost:8090/v1
NERV_EMBED_MODEL=bge-m3
# 외부 제공자를 쓸 때 필수. secret이다
NERV_EMBED_API_KEY=
# 1024를 그대로 내는 모델(bge-m3)은 false, 절단이 필요한 모델(text-embedding-3-*)은 true.
# 주소로 추정하지 않는다. 게이트웨이 뒤의 같은 모델이 1536을 돌려주면 검색이 조용히 렉시컬로
# 떨어진다(REQ-CB-033).
NERV_EMBED_SEND_DIMENSIONS=false
# MRL(Matryoshka) 모델의 긴 벡터를 받는 쪽에서 잘라 맞춘다. 모델 카드를 보고 켠다(§5.2a)
NERV_EMBED_TRUNCATE=false
# compose 포트 노출(127.0.0.1 한정). 로컬 프로필 전용
NERV_EMBED_PORT=8090
# 한 요청의 예산 둘. 지연은 입력 개수보다 총 문자 수를 따라간다(§5.2b).
# 빠른 제공자는 BATCH_CHARS를 올려 왕복을 줄인다.
NERV_EMBED_TIMEOUT_MS=30000
NERV_EMBED_BATCH_CHARS=6000

# ── ⑤ 워커·잡 루프 ─────────────────────────────────────────────────────────
# 임베딩 한 판의 시간 상한. 비싼 잡이 급한 잡(리스 회수 · stale)을 밀어내지 않게 한다
NERV_EMBED_PASS_MS=20000
# 일감이 있을 때의 임베딩 주기. 없으면 5분 주기로 내려간다
NERV_EMBED_EVERY_MS=1000
# 잡 루프의 틱 해상도. 잡이 1초 주기를 원해도 틱이 더 성기면 그 간격으로 돈다
NERV_WORKER_TICK_MS=1000

# ── ⑥ 오브젝트 스토리지 (MinIO · S3 호환) ───────────────────────────────────
MINIO_ROOT_USER=nerv
# 필수
MINIO_ROOT_PASSWORD=
# compose 포트 노출(127.0.0.1 한정). 개발 루프용
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# 서버가 S3에 붙는 주소. compose 안에서는 http://minio:9000
NERV_S3_ENDPOINT=http://localhost:9000
# 앱이 읽는 자격증명은 이 둘이다. MINIO_ROOT_*는 compose가 MinIO에 주는 값이라 로컬
# 프로세스(pnpm dev)에는 전달되지 않는다.
NERV_S3_ACCESS_KEY=nerv
NERV_S3_SECRET_KEY=
# 에이전트가 받는 presigned PUT 주소. 밖에서 열려야 하므로 앞문 밖의 별도 호스트를 적는다
# (예 https://s3.nerv.example.com). 경로 접두(/s3)는 안 된다. 서명이 경로를 포함해서, 앞문이
# 접두를 떼면 SignatureDoesNotMatch다(REQ-CB-034).
NERV_S3_PUBLIC_ENDPOINT=http://localhost:9000
# api가 기동할 때 없으면 만든다
NERV_S3_BUCKET=nerv-blobs
# 서명에 들어간다. MinIO는 아무 값이나 받지만 실제 S3·R2는 이 값으로 검증한다
NERV_S3_REGION=us-east-1
# minio 호환
NERV_S3_FORCE_PATH_STYLE=true

# ── ⑦ 외부 연동 ────────────────────────────────────────────────────────────
# GitHub 웹훅 서명 검증(EP-WHK-01). 비면 모든 웹훅이 401이다
NERV_GITHUB_WEBHOOK_SECRET=
# 저장하는 비밀의 암호화 키(2026-10-17). Slack 웹훅 주소를 DB에 암호문으로 둔다.
# openssl rand -base64 32 로 만든다. 비면 Slack 연결을 받지 않고, 바꾸면 저장된 웹훅을
# 풀 수 없어 프로젝트마다 다시 연결해야 한다
NERV_ENCRYPTION_KEY=
# Slack 웹훅 주소가 시작해야 하는 곳. 비면 https://hooks.slack.com/services/ 다
# (사내 중계를 쓸 때만 바꾼다)
# NERV_SLACK_WEBHOOK_PREFIX=
# md 미러 산출 위치(export 잡). 비면 미러를 만들지 않는다. 이 폴더가 git 저장소가 되고,
# 내용이 바뀌면 커밋한다
# NERV_EXPORT_DIR=./.nerv/mirror
# 미러를 push 할 원격. 비면 로컬 커밋까지만 한다. 자격증명이 URL에 들어갈 수 있어 비밀로
# 다룬다. fast-forward로만 push 하고, 원격에 NERV가 만들지 않은 커밋이 있으면 멈추고
# admin에게 알린다
# NERV_MIRROR_GIT_REMOTE=
# 원격 브랜치(비면 main) · 커밋 작성자(이름 <메일> 모양 · 비면 NERV <nerv@localhost>)
# NERV_MIRROR_GIT_BRANCH=main
# NERV_MIRROR_GIT_AUTHOR=NERV <nerv@localhost>

# ── ⑦b 메일 ────────────────────────────────────────────────────────────────
# 호스트가 비면 메일을 보내지 않고 아웃박스에 쌓지도 않는다. 개발 루프는 compose의 mailpit을
# 가리킨다. 접속 정보는 다섯이다(2026-09-24). k8s는 주소 셋(HOST · PORT · SECURE)을
# ConfigMap에, 인증 두 키(USER · PASS)를 nerv-secrets에 둔다.
NERV_MAIL_HOST=mailpit
# 비우면 587(submission · STARTTLS). 25는 사업자가 막아 둔 서버 간 릴레이 포트다.
# 읽을 수 없는 값이면 기동을 거부한다. 조용히 587로 가면 오타가 영영 드러나지 않는다.
NERV_MAIL_PORT=1025
# 접속하자마자 TLS를 쓰는가. 비우면 포트에서 유도한다(465면 true, 그 밖은 false).
# 여기가 사람이 가장 자주 틀리는 자리라 기본값을 두지 않는다.
# NERV_MAIL_SECURE=
# 인증. 둘 다 적거나 둘 다 비운다. 한쪽만 있으면 기동을 거부한다. mailpit은 불요.
# NERV_MAIL_USER=
# NERV_MAIL_PASS=
# 보내는 사람. 호스트를 켜 놓고 비우면 기동을 거부한다. 보내는 사람 없는 메일은 거절되거나
# 스팸함으로 간다.
NERV_MAIL_FROM=NERV <no-reply@nerv.example.com>
# 사람이 답장할 주소. no-reply로만 두면 문의가 갈 곳이 없다
# NERV_MAIL_REPLY_TO=
# 아웃박스는 쌓고 보내지는 않는다. 첫 배포에서 무엇이 나갈지 먼저 볼 때 켠다
NERV_MAIL_DRY_RUN=false
# 가입 이메일 인증을 강제할 것인가. 비우면 위 NERV_MAIL_HOST 유무를 따른다. 메일이 있는
# 배치는 강제이고, 없는 배치는 인증 메일을 보낼 수 없어 강제하지도 못한다. true로 켜 놓고
# 호스트를 비우면 기동을 거부한다.
# NERV_REQUIRE_EMAIL_VERIFICATION=

# ── ⑧ 이미지·로그 ──────────────────────────────────────────────────────────
# compose 이미지 태그. 운영 태깅은 §6.4(git SHA)
NERV_TAG=dev
# verbose · debug · log(=info) · warn · error · fatal. 고른 수준과 그보다 심각한 것을 켠다
NERV_LOG_LEVEL=info
# text · json. 비면 text다(개발 루프는 사람이 읽는다). compose는 비어 있으면 json을 넘긴다
# (컨테이너 로그는 수집기가 읽는다 · §5.5). json은 한 줄에 JSON 하나이고 req_id로 요청을 잇는다
NERV_LOG_FORMAT=
# 클라이언트 주소(§5.5). 믿는 프록시의 CIDR을 쉼표로 적는다. 비면 loopback · 사설 대역
NERV_TRUSTED_PROXIES=
# 클라이언트 주소를 담은 헤더. 비면 믿지 않는다. Cloudflare(Tunnel 포함)면 cf-connecting-ip
NERV_CLIENT_IP_HEADER=
