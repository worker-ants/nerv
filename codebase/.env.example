# NERV 로컬/자가호스팅 환경변수 — 정본: docs/04-mvp/codebase.md §5.2 전표
#
#   cp .env.example .env
#
# 필수 3개(POSTGRES_PASSWORD · MINIO_ROOT_PASSWORD · NERV_AUTH_SECRET)만 채우면 기동된다.
# 나머지는 전부 기본값으로 동작한다.
#
# 에이전트 장비 쪽 변수(NERV_TOKEN · NERV_PROJECT · NERV_HOSTNAME)는 이 전표가 아니다 —
# 정본은 docs/03-proposal/agent-integration.md §3.3·§4.1, 설치 절차는 docs/04-mvp/plugin.md.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=nerv
# 필수
POSTGRES_PASSWORD=
POSTGRES_DB=nerv
# compose 포트 노출(127.0.0.1 한정) — 개발 루프용
POSTGRES_PORT=5432
# 개발 루프(pnpm dev)에서만 필요. compose 내부에서는 postgres 호스트로 자동 조립된다.
DATABASE_URL=postgres://nerv:CHANGEME@localhost:5432/nerv

# ── API ─────────────────────────────────────────────────────────────────────
NERV_API_PORT=8080
# 경로 없는 오리진만. 세션 쿠키·CORS·/mcp Origin 검증 기준
NERV_PUBLIC_URL=http://localhost:8080
# 필수 — openssl rand -base64 32
NERV_AUTH_SECRET=

# ── Valkey (실시간 방송 MQ — nerv_events pub/sub) ────────────────────────────
# compose 포트 노출(127.0.0.1 한정) — 개발 루프용
VALKEY_PORT=6379
# Valkey 는 RESP 프로토콜이라 redis:// 스킴. compose 내부는 redis://valkey:6379
NERV_VALKEY_URL=redis://localhost:6379

# ── 임베딩 제공자 (OpenAI 호환 /v1/embeddings 단일 계약 — §5.2a) ─────────────
# 프로필은 아래 3종. 코드는 제공자를 모른다 — 이 3키만 바꾼다(REQ-CB-020).
#   로컬(기본값) : NERV_EMBED_URL=http://embed:11434/v1           MODEL=bge-m3                 KEY 불요
#                  compose 는 --profile local-embed 로 embed 서비스를 함께 띄운다(ollama — amd64·arm64)
#   스테이징     : NERV_EMBED_URL=http://<lmstudio-host>:1234/v1  MODEL=bge-m3 계열(GGUF)
#   운영         : NERV_EMBED_URL=https://api.openai.com/v1       MODEL=text-embedding-3-small  KEY 필수
#                  OpenAI 프로필은 요청에 dimensions:1024 를 항상 포함한다(REQ-CB-021)
# 차원은 전 프로필 1024 고정이며, 프로필 전환은 전량 재임베딩이다(벡터 공간이 다르다).
NERV_EMBED_URL=http://localhost:8090/v1
NERV_EMBED_MODEL=bge-m3
# 외부 제공자 사용 시 필수 — secret
NERV_EMBED_API_KEY=
# compose 포트 노출(127.0.0.1 한정) — 로컬 프로필 전용
NERV_EMBED_PORT=8090

# ── MinIO (S3 호환 오브젝트 스토리지) ────────────────────────────────────────
MINIO_ROOT_USER=nerv
# 필수
MINIO_ROOT_PASSWORD=
# compose 포트 노출(127.0.0.1 한정) — 개발 루프용
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# compose 내부는 http://minio:9000
NERV_S3_ENDPOINT=http://localhost:9000
# api 가 기동 시 없으면 생성
NERV_S3_BUCKET=nerv-blobs
NERV_S3_FORCE_PATH_STYLE=true

# ── 배포·운영 ───────────────────────────────────────────────────────────────
# compose web 서비스의 공개 포트
NERV_HTTP_PORT=8080
# compose 이미지 태그. 운영 태깅은 §6.4(git SHA)
NERV_TAG=dev
NERV_LOG_LEVEL=info
