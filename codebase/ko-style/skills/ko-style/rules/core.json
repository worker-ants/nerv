{
  "$comment": "ko-style 공통 규칙 — 규범 층(norm)과 AI 말투 층(ai). 팀 어휘는 사용자 저장소의 .ko-style.json 에 둔다. 규칙마다 bad 예문은 반드시 걸리고 good 예문은 걸리지 않아야 한다(ko-style.spec.ts 가 확인한다). 정본 설명은 docs/04-mvp/plugin.md §7.",
  "version": 1,
  "rules": [
    {
      "id": "KO-N-01",
      "layer": "norm",
      "level": "warn",
      "name": "무생물 주어의 사람 동작",
      "pattern": "(?:화면|서버|문서|카드|배지|응답|로그|결과|검사|메시지|버튼|표|절|데이터|코드|테스트|오류|에러)(?:이|가|은|는)\\s(?:(?:(?!(?:면|고|서|니|며|때|데)\\s)[^.!?\\n—,]){0,24}?\\s)?(?:말한다|말합니다|말해\\s?준다|말해\\s?줍니다|말하고\\s?있다|말하고\\s?있습니다|묻는다|묻습니다)",
      "use": "\"화면에 표시된다\", \"결과를 보면 알 수 있다\"처럼 쓴다",
      "src": "국립국어원 「공공언어 바로 쓰기」",
      "examples": {
        "bad": [
          "화면이 그 이유를 말합니다.",
          "결과가 성능 문제를 말해 준다."
        ],
        "good": [
          "화면에 그 이유가 표시됩니다.",
          "결과를 보면 성능 문제가 있다.",
          "문서가 있으면 그 표를 옮길지 묻는다."
        ]
      }
    },
    {
      "id": "KO-N-02",
      "layer": "norm",
      "level": "block",
      "name": "이중 피동",
      "pattern": "(?:되어|보여|쓰여|읽혀|불려|잊혀|짜여|놓여)(?:지|진|집|져|졌|질)",
      "use": "\"반영된다\", \"보인다\", \"쓰인다\"",
      "src": "국립국어원 「공공언어 바로 쓰기」 · 쿠버네티스 한글화 가이드",
      "examples": {
        "bad": [
          "변경 내용이 바로 반영되어집니다.",
          "화면에 목록이 보여진다."
        ],
        "good": [
          "변경 내용이 바로 반영됩니다.",
          "화면에 목록이 보인다."
        ]
      }
    },
    {
      "id": "KO-N-03",
      "layer": "norm",
      "level": "block",
      "name": "\"필요로 하다\"",
      "pattern": "필요로\\s?(?:한다|합니다|하는|하며|하고|했다|했습니다|하지|해야|할)",
      "use": "\"~이 필요하다\"",
      "src": "국립국어원 「공공언어 바로 쓰기」",
      "examples": {
        "bad": [
          "이 작업은 관리자 권한을 필요로 합니다."
        ],
        "good": [
          "이 작업에는 관리자 권한이 필요합니다."
        ]
      }
    },
    {
      "id": "KO-N-04",
      "layer": "norm",
      "level": "hint",
      "name": "\"~에 있어서\"",
      "pattern": "에\\s?있어서(?![가-힣])",
      "use": "\"~에서\", \"~할 때\" (장소나 까닭을 뜻하면 그대로 둔다)",
      "src": "국립국어원 「공공언어 바로 쓰기」",
      "examples": {
        "bad": [
          "개발에 있어서 테스트는 빼놓을 수 없다."
        ],
        "good": [
          "개발할 때 테스트는 빼놓을 수 없다."
        ]
      }
    },
    {
      "id": "KO-N-05",
      "layer": "norm",
      "level": "hint",
      "name": "\"~에 의해\"",
      "pattern": "에\\s?의(?:해서?|한)(?![가-힣])",
      "use": "능동문으로 쓴다 (\"관리자가 바꿨다\")",
      "src": "국립국어원 「공공언어 바로 쓰기」",
      "examples": {
        "bad": [
          "설정은 관리자에 의해 변경되었다."
        ],
        "good": [
          "관리자가 설정을 바꿨다."
        ]
      }
    },
    {
      "id": "KO-N-06",
      "layer": "norm",
      "level": "hint",
      "name": "\"~을 통해\"",
      "pattern": "(?:을|를)\\s통해서?(?![가-힣])",
      "use": "문맥에 맞는 조사나 동사 (\"~으로\", \"~에서\")",
      "src": "국립국어원 「공공언어 바로 쓰기」 · 김순영(2012)",
      "examples": {
        "bad": [
          "이 API 를 통해 데이터를 가져온다."
        ],
        "good": [
          "이 API 로 데이터를 가져온다."
        ]
      }
    },
    {
      "id": "KO-N-07",
      "layer": "norm",
      "level": "warn",
      "name": "\"가지다\" (have 직역)",
      "pattern": "(?:권한|기능|값|필드|속성|의미|구조|역할|책임|옵션|이름|형식|정보)(?:을|를)\\s(?:가지고\\s?있|가진다|가집니다|갖는다|갖습니다|갖고\\s?있)",
      "use": "\"~이 있다\"",
      "src": "김순영(2012) · Microsoft 한국어 스타일 가이드",
      "examples": {
        "bad": [
          "이 필드는 기본값을 가지고 있다."
        ],
        "good": [
          "이 필드에는 기본값이 있다."
        ]
      }
    },
    {
      "id": "KO-N-08",
      "layer": "norm",
      "level": "warn",
      "name": "\"수행하다\" 덧붙이기",
      "pattern": "(?:설치|삭제|제거|실행|검사|확인|업데이트|배포|저장|작업|변경|테스트|빌드)(?:를|을)?\\s?수행(?:한다|합니다|하면|했다|했습니다|하고|하는|해야|할)",
      "use": "\"설치한다\", \"설치하면\"",
      "src": "Microsoft 한국어 스타일 가이드",
      "examples": {
        "bad": [
          "설치를 수행하면 설정 파일이 생긴다."
        ],
        "good": [
          "설치하면 설정 파일이 생긴다."
        ]
      }
    },
    {
      "id": "KO-N-09",
      "layer": "norm",
      "level": "warn",
      "name": "\"요구된다\" 피동",
      "pattern": "(?:이|가)\\s요구(?:됩니다|된다|되는|되며)",
      "use": "\"~해야 한다\"",
      "src": "국립국어원 「공공언어 바로 쓰기」",
      "examples": {
        "bad": [
          "배포 전에 주의가 요구됩니다."
        ],
        "good": [
          "배포 전에 주의해야 합니다."
        ]
      }
    },
    {
      "id": "KO-N-10",
      "layer": "norm",
      "level": "hint",
      "name": "\"~에 대해\"",
      "pattern": "에\\s?대(?:해서?|한|하여)(?![가-힣])",
      "use": "목적어로 바로 쓴다 (\"이 기능을 설명한다\"). 사람 글에도 흔하므로 문맥으로 판단한다",
      "src": "국립국어원 「공공언어 바로 쓰기」",
      "examples": {
        "bad": [
          "이 기능에 대해 설명한다."
        ],
        "good": [
          "이 기능을 설명한다."
        ]
      }
    },
    {
      "id": "KO-P-01",
      "layer": "norm",
      "level": "warn",
      "name": "짝 없는 줄표",
      "custom": "dash",
      "use": "마침표로 문장을 끊거나, 끼워 넣는 말이면 앞뒤를 짝으로 감싼다",
      "src": "한글 맞춤법 문장 부호 (2015 시행)",
      "examples": {
        "bad": [
          "서버는 응답에 이유를 담는다 — 화면에는 그 이유가 표시된다."
        ],
        "good": [
          "서버는 응답에 이유를 담는다. 화면에는 그 이유가 표시된다.",
          "관계 그래프 — 문서가 늘어도 형태가 그대로다"
        ]
      }
    },
    {
      "id": "KO-P-02",
      "layer": "norm",
      "level": "hint",
      "name": "문장 끝 쌍점",
      "pattern": "[가-힣]다\\s?:(?=[ \\t]*(?:\\n|$))",
      "use": "마침표로 끝낸다",
      "src": "한글 맞춤법 문장 부호 · Microsoft 한국어 스타일 가이드",
      "examples": {
        "bad": [
          "토큰을 발급하려면 다음 권한이 필요합니다:"
        ],
        "good": [
          "토큰을 발급하려면 다음 권한이 필요합니다."
        ]
      }
    },
    {
      "id": "KO-A-01",
      "layer": "ai",
      "level": "warn",
      "freq": 2,
      "rate": 0.05,
      "name": "\"A가 아니라 B\" 되풀이",
      "pattern": "(?:이|가)\\s아니라(?![가-힣])",
      "use": "대비가 꼭 필요할 때 한 번만 쓴다",
      "src": "im-not-ai 측정 · Wikipedia \"Signs of AI writing\"",
      "examples": {
        "bad": [
          "코드가 아니라 스펙이 기준이다. 결정은 서버가 아니라 사람이 한다."
        ],
        "good": [
          "스펙을 기준으로 개발한다. 결정은 사람만 할 수 있다."
        ]
      }
    },
    {
      "id": "KO-A-02",
      "layer": "ai",
      "level": "warn",
      "freq": 3,
      "rate": 0.12,
      "name": "연결 어미 뒤 쉼표",
      "pattern": "(?:지만|는데|은데|므로|어서|아서|해서|으며|면서|(?<![보참광창경재최사신원공제금선잔노수기고])고),(?=\\s)",
      "use": "쉼표를 뺀다",
      "src": "KatFishNet (ACL 2025)",
      "examples": {
        "bad": [
          "요청이 늘었지만, 서버는 그대로다. 설정을 바꿨는데, 결과는 같았다. 다시 확인해서, 새로 올렸다."
        ],
        "good": [
          "요청이 늘었지만 서버는 그대로다. 설정을 바꿨는데 결과는 같았다."
        ]
      }
    },
    {
      "id": "KO-T-01",
      "layer": "norm",
      "level": "warn",
      "name": "정한 말투와 다름",
      "custom": "tone",
      "use": "저장소 설정(.ko-style.json)이 이 글 종류에 정한 말투로 쓴다",
      "src": "저장소 설정 · 한 종류의 글 안에서는 말투를 섞지 않는다",
      "examples": {
        "bad": [],
        "good": []
      }
    }
  ]
}
