{
  "name": "@nerv/api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "NERV API — REST · MCP · WebSocket · SSE · ingest 다섯 표면과 도메인 서비스, 워커 잡 (docs/04-mvp/codebase.md §2)",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "dev": "node --env-file-if-exists=../../.env --watch dist/main.js",
    "db:migrate": "node --env-file-if-exists=../../.env dist/migrate.js",
    "db:seed": "node --env-file-if-exists=../../.env dist/seed.js",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@fastify/multipart": "^10.1.1",
    "@nerv/schema": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/websockets": "^11.2.1",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@swc/core": "^1.16.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  }
}
