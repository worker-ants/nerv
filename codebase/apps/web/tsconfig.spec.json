{
  "extends": "../../tsconfig.base.json",
  "_comment": "L1 스펙의 타입 검사 전용(codebase.md §4.3).",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "rootDir": "./src",
    "outDir": "./.tsbuild-spec",
    "emitDeclarationOnly": true
  },
  "include": ["src/**/*.spec.ts", "src/**/*.spec.tsx"],
  "references": [{ "path": "./tsconfig.json" }, { "path": "../../packages/schema" }]
}
