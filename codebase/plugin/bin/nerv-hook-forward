#!/usr/bin/env bash
# nerv-hook-forward — 훅 이벤트 포워더 (plugin.md §3.1 주의 · Codex 공용 — §5.4)
#
# 존재 이유는 하나다: 훅 `headers` 에서 `${NERV_TOKEN}` 확장이 되지 않는 호스트가 있을 때
# `type:"http"` 를 `type:"command"` 로 바꿔 **같은 요청을 같은 엔드포인트에** 보내기 위해서다.
# 토큰 주입만 이 스크립트가 하고, 나머지는 http 훅과 동일하다 — 훅은 텔레메트리 평면이라
# 끊겨도 세션은 진행되고 게이트는 서버가 유지한다.
#
# 일이 하나 더 있다(2026-10-16 · 사람 결정 · REQ-PLG-032): 서버에서 2xx 를 받으면 그것을 복구 신호로 삼아
# 오프라인 큐(`nerv-outbox`)를 백그라운드로 비우게 한다 — 맨 아래 절.
#
# 사용: hooks.json 에서
#   { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/nerv-hook-forward session" }
# stdin 으로 들어온 훅 페이로드를 그대로 전달한다. Claude Code 와 Codex 가 같은 hooks.json 으로 이 스크립트를 부른다.
set -uo pipefail

# 이 스크립트의 자리 — notify 는 아래에서 그 턴의 디렉터리로 옮기므로 상대 경로가 아니라 절대 경로로 둔다
here="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Codex 의 `notify` 는 **인자로** 부른다: `notify = [".../nerv-hook-forward", "--event", "notify"]`
# 뒤에 JSON 페이로드가 마지막 argv 로 붙고 stdin 은 열리지 않는다. 그대로 두면 `--event` 가
# 엔드포인트 이름이 되어 `/ingest/hooks/--event` 로 빈 본문이 갔다(2026-09-02 정정).
if [[ "${1:-}" == "--event" ]]; then
  endpoint="${2:?사용법: nerv-hook-forward --event <name> <json>}"
  payload="${3:-}"
else
  endpoint="${1:?사용법: nerv-hook-forward <session|tool|subagent|stop|session-end>}"
  # 훅은 stdin 으로 온다(Claude Code · Codex 같다)
  payload="$(cat)"
fi
# 본문이 비면 보내지 않는다 — 서버의 빈 훅 처리를 늘리는 것보다 여기서 멈추는 편이 낫다
[[ -z "${payload}" ]] && exit 0

# **NERV 를 설정한 저장소의 일만 보낸다**(2026-10-16 · 사람 결정 · REQ-PLG-041 · REQ-PLG-038 · plugin.md §3.1).
#
# 플러그인은 기계에 하나라 훅이 모든 저장소에서 돌고, Codex 의 `notify` 는 사용자 설정(`~/.codex/config.toml`)에만 둘 수
# 있어 모든 저장소의 턴에 불린다. 예전에는 셸에 토큰이 있으면 NERV 를 쓰지 않는 저장소의 명령 · 파일 경로(도구 훅)와
# 답변(notify)까지 서버로 나갔다 — 서버가 세션을 못 찾아 버려도 전송은 됐다. 이제 둘 중 하나일 때만 보낸다.
#   ① 그 일의 디렉터리가 NERV 를 설정한 저장소다 — 훅 입력 · 알림의 `cwd`(없으면 이 프로세스의 디렉터리)나 그 git 저장소의
#      맨 위에 설정이 있다(`nerv_config_root` · nerv-env.sh). Claude Code 의 훅은 세션을 연 저장소(`CLAUDE_PROJECT_DIR`)도 본다 —
#      에이전트가 저장소 밖으로 `cd` 해도 그 세션은 그 저장소의 일이다. Codex 의 훅(`PLUGIN_ROOT`)과 notify 에서는 보지
#      않는다 — 그 값이 Codex 를 띄운 셸에서 이어진 것일 수 있다(`CLAUDECODE` 를 보지 않는 이유와 같다 · 아래 에이전트 판정).
#   ② 관리형 설치다 — 조직이 관리형 settings 의 env 에 `NERV_MANAGED=1` 을 두었다(`nerv_managed`). 저장소에 파일이 없어도
#      그 기계의 모든 작업 저장소가 NERV 대상이라는 조직의 선택이다. 셸에 우연히 있는 토큰과 구별하는 표시다.
# 그리고 토큰이 있을 때만 보낸다. 아니면 아무것도 보내지 않고 성공으로 끝낸다 — 출력도 없다(세션 안내를 기다리는
# SessionStart 도 빈 성공이다). 훅이 실패로 보이면 안 된다: Codex 는 훅 출력의 모양에 민감하다(REQ-API-323).
#
# 판정은 `nerv-init`(온보딩 · `--check`) · `nerv-outbox` 와 같은 함수다. http 변형(`hooks.http.json`)의 http 훅은 이 스크립트를
# 거치지 않고 서버로 바로 가서 이 판정이 적용되지 않는다(plugin.md §3.1).
turn_dir="$(printf '%s' "${payload}" | grep -o '"cwd"[[:space:]]*:[[:space:]]*"[^"\\]*"' | head -n 1 |
  sed 's/^"cwd"[[:space:]]*:[[:space:]]*"\(.*\)"$/\1/')"

# notify 는 그 턴의 디렉터리로 옮겨 그 저장소의 `.nerv/env` 를 읽는다. 훅은 호스트가 부른 자리 그대로다(브랜치를 거기서 읽는다)
if [[ "${endpoint}" == "notify" && -n "${turn_dir}" ]]; then
  cd "${turn_dir}" 2>/dev/null || exit 0
fi

# 프로젝트별 환경(.nerv/env) — 같은 기계에서 저장소마다 다른 값을 쓴다(plugin.md §3.3). 관리형 표시는 파일에서 읽지 않는다
. "${here}/nerv-env.sh"

candidates=("${turn_dir:-$PWD}")
if [[ "${endpoint}" != "notify" && -z "${PLUGIN_ROOT:-}" && -n "${CLAUDE_PROJECT_DIR:-}" ]]; then
  candidates+=("${CLAUDE_PROJECT_DIR}")
fi
root=""
for candidate in "${candidates[@]}"; do
  root="$(nerv_config_root "${candidate}")" && break
  root=""
done
[[ -n "${root}" ]] || nerv_managed || exit 0
# 설정을 찾은 자리가 이 디렉터리가 아니면(하위 폴더 · 세션의 저장소) 그 저장소의 `.nerv/env` 로 빈 칸을 채운다
if [[ -n "${root}" && -z "${NERV_ENV_FILE:-}" ]]; then
  NERV_ENV_FILE="${root}/.nerv/env" nerv_load_env
fi
[[ -n "${NERV_TOKEN:-}" ]] || exit 0
base="${NERV_SERVER:-https://api.nerv.example.com}"

# **브랜치는 모델이 아니라 git 이 말한다**(2026-09-03 · 사람 결정).
#
# 세션의 신원 3요소 중 branch·worktree 는 지금까지 `nerv_bootstrap` 인자로만 올 수 있었고,
# 모델이 그것을 실어 준 적이 없어 **실사용 세션 34개 전부 NULL** 이었다(실측). 훅은 프로젝트
# 디렉터리에서 돌므로 여기서 git 에게 직접 물으면 모델을 거치지 않는다.
#
# 두 자리에서만 묻는다 — 세션을 만드는 훅과 도구 훅이다. 앞은 처음 채우고 뒤는 신선하게
# 유지한다(브랜치는 세션 도중 바뀐다). 나머지 훅에서 git 을 부르는 것은 값 없는 비용이다.
extra=()
case "${endpoint}" in
  session | tool)
    if command -v git >/dev/null 2>&1; then
      ref="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
      # **detached HEAD 는 브랜치가 아니다.** 그대로 보내면 서로 다른 작업 수십 개가
      # 게이트 현황에서 "HEAD" 한 행으로 뭉친다 — 없는 것과 잘못된 것은 다르다.
      if [[ -n "${ref}" && "${ref}" != "HEAD" ]]; then
        extra+=(--header "X-NERV-Branch: ${ref}")
      fi
      top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
      [[ -n "${top}" ]] && extra+=(--header "X-NERV-Worktree: ${top}")
    fi
    ;;
esac

# **플러그인이 켜져 있다는 것은 플러그인만 말할 수 있다**(2026-09-24 · E12-S03 · plugin.md §3.1).
#
# 세션은 두 길로 들어온다 — 이 훅(플러그인)과 MCP `nerv_bootstrap`(플러그인 없이도 된다).
# 서버는 둘을 가를 칸이 없어서, 관리형 settings 로 배포한 뒤 "어느 기계에서 켜졌는가" 를
# 답하지 못했다. 세션을 만드는 훅에서만 자기 버전을 싣는다 — 다른 훅은 같은 세션이다.
# 버전은 이 스크립트 옆의 `plugin.json` 이 정본이다(REQ-PLG-017). Codex 도 플러그인으로 설치하면
# 같은 매니페스트로 설치하므로 이 파일이 옆에 있다(2026-10-15 실측 · plugin.md §5.4) — 두 호스트 모두 싣는다.
# 파일이 없으면(스크립트만 따로 복사해 notify 로 부르는 설치) 헤더를 빼고, 없는 것을 있다고 말하지 않는다.
if [[ "${endpoint}" == "session" ]]; then
  manifest="${here}/../.claude-plugin/plugin.json"
  if [[ -r "${manifest}" ]]; then
    version="$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${manifest}" | head -n 1)"
    [[ -n "${version}" ]] && extra+=(--header "X-NERV-Plugin: ${version}")
  fi
fi

# **누가 부르는지는 호스트가 준 환경으로 안다**(2026-10-16 · E20-S01 · plugin.md §5.4 · REQ-PLG-034).
#
# 훅 입력에는 에이전트 필드가 없다 — 두 호스트 모두 세션 id · cwd · 이벤트 이름만 준다. 예전에는 기본값이
# `claude-code` 라 Codex 세션이 Claude Code 세션으로 기록됐다(2026-10-15 실측). 2026-10-16 실측에서 Codex 0.162.1 은
# 플러그인 훅에 `PLUGIN_ROOT` · `PLUGIN_DATA` 를 주고 Claude Code 2.1.301 은 주지 않는다(`CLAUDE_PLUGIN_ROOT` 는 둘 다 준다). 그래서
# 순서는 ① 사람이 정한 `NERV_AGENT_TYPE` ② `notify`(Codex 에만 있다) ③ `PLUGIN_ROOT` 가 있으면 Codex ④ 그 밖은
# Claude Code 다. `CLAUDECODE` 로 보지 않는다 — Claude Code 의 셸에서 Codex 를 띄우면 그 값이 Codex 훅까지 이어진다.
agent="${NERV_AGENT_TYPE:-}"
if [[ -z "${agent}" ]]; then
  if [[ "${endpoint}" == "notify" || -n "${PLUGIN_ROOT:-}" ]]; then
    agent="codex"
  else
    agent="claude-code"
  fi
fi

# **SessionEnd 는 짧게 끝낸다.** Codex 는 SessionEnd 훅의 시한을 3초로 줄여 실행한다(2026-10-15 실측 — 경고가
# 남는다). hooks.json 의 시한(3초)보다 먼저 끝나야 응답을 기다리다 잘리지 않는다.
max_time="${NERV_HOOK_TIMEOUT:-5}"
[[ "${endpoint}" == "session-end" ]] && max_time="2"

# 실패해도 0 으로 끝낸다 — 훅의 실패가 세션을 멈추면 텔레메트리가 조정 경로가 되어버린다.
# 상태 코드도 받는다 — 2xx 는 "서버가 돌아왔다" 는 신호다(아래 outbox).
# `X-NERV-Agent` 는 모든 훅에 싣는다 — 서버가 세션의 종류를 정하고(세션 훅) 그 호스트가 받는 모양으로 답한다(모든 훅).
response="$(curl --silent --show-error --max-time "${max_time}" --write-out '\n%{http_code}' \
  --request POST "${base}/ingest/hooks/${endpoint}" \
  --header "content-type: application/json" \
  --header "Authorization: Bearer ${NERV_TOKEN:-}" \
  --header "X-NERV-Project: ${NERV_PROJECT:-}" \
  --header "X-NERV-Host: ${NERV_HOSTNAME:-$(hostname -s 2>/dev/null || echo unknown)}" \
  --header "X-NERV-Agent: ${agent}" \
  ${extra[@]+"${extra[@]}"} \
  --data "${payload}" 2>/dev/null || printf '\n000')"
status="${response##*$'\n'}"
response="${response%$'\n'*}"

# **응답을 흘려보낸다**(2026-09-03). 예전에는 본문을 `/dev/null` 로 버렸다 — 그래서 이 경로를
# 쓰는 설치에서는 SessionStart 의 컨텍스트 주입도, Stop 의 `{"decision":"block"}` 도 모델에
# 도달하지 못했다. command 훅의 stdout 은 **JSON 이면 판정으로 읽힌다**(http 훅의 응답 본문과
# 같은 자리다). JSON 이 아닌 것은 내보내지 않는다: 프록시의 HTML 오류 페이지가 전사에 섞이면
# 사람이 그것을 훅의 말로 읽는다. Codex 는 판정 JSON 에 모르는 필드가 있으면 훅을 실패로 끝낸다 — 서버가
# `X-NERV-Agent: codex` 에는 그 호스트가 받는 필드만 돌려준다(api.md §2.9 · REQ-API-323). notify 의 출력은 Codex 가 읽지 않는다.
case "${response}" in
  '{'*) [[ "${endpoint}" == "notify" ]] || printf '%s' "${response}" ;;
esac

# **서버가 돌아왔으면 오프라인 큐를 바로 비운다**(2026-10-16 · 사람 결정 · E21-S01 · REQ-PLG-032 · plugin.md §3.4).
#
# 예전에는 세션 시작 훅만 큐를 비웠다 — 서버가 세션 도중에 돌아오면 밀린 상태 보고 · 질문 · 증적은 다음 세션까지
# 기다렸고, 그동안 플랫폼은 그 작업이 멈춘 것으로 보였다. 데몬을 따로 띄우지 않고 이 훅이 2xx 를 받는 순간을
# 복구 신호로 쓴다. `kick` 은 보낼 것이 없으면 아무것도 하지 않고, 있으면 flush 를 분리된 백그라운드로 띄운 뒤
# 바로 돌아온다 — 훅은 짧게 끝나야 한다. 세션을 만드는 훅에서는 띄우지 않는다: 같은 SessionStart 에서 flush 훅이 따로 돈다.
# 출력은 버린다 — 이 스크립트의 stdout 은 판정(JSON)으로 읽힌다.
if [[ "${status}" =~ ^2 && "${endpoint}" != "session" ]]; then
  "${here}/nerv-outbox" kick >/dev/null 2>&1 </dev/null || true
fi

exit 0
