#!/usr/bin/env bash
# nerv-hook-forward — 훅 이벤트 포워더 (plugin.md §3.1 주의 · Codex 공용)
#
# 존재 이유는 하나다: 훅 `headers` 에서 `${NERV_TOKEN}` 확장이 되지 않는 호스트가 있을 때
# `type:"http"` 를 `type:"command"` 로 바꿔 **같은 요청을 같은 엔드포인트에** 보내기 위해서다.
# 토큰 주입만 이 스크립트가 하고, 나머지는 http 훅과 동일하다 — 훅은 텔레메트리 평면이라
# 끊겨도 세션은 진행되고 게이트는 서버가 유지한다.
#
# 사용: hooks.json 에서
#   { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/nerv-hook-forward session" }
# stdin 으로 들어온 훅 페이로드를 그대로 전달한다.
set -uo pipefail

# 프로젝트별 환경(.nerv/env) — 같은 기계에서 저장소마다 다른 값을 쓴다(plugin.md §3.3)
. "$(dirname "${BASH_SOURCE[0]}")/nerv-env.sh"

# Codex 의 `notify` 는 **인자로** 부른다: `notify = [".../nerv-hook-forward", "--event", "notify"]`
# 뒤에 JSON 페이로드가 마지막 argv 로 붙고 stdin 은 열리지 않는다. 그대로 두면 `--event` 가
# 엔드포인트 이름이 되어 `/ingest/hooks/--event` 로 빈 본문이 갔다(2026-09-02 정정).
if [[ "${1:-}" == "--event" ]]; then
  endpoint="${2:?사용법: nerv-hook-forward --event <name> <json>}"
  payload="${3:-}"
else
  endpoint="${1:?사용법: nerv-hook-forward <session|tool|subagent|stop|session-end>}"
  # Claude 경로는 stdin 으로 온다
  payload="$(cat)"
fi
base="${NERV_SERVER:-https://nerv.example.com}"
# 본문이 비면 보내지 않는다 — 서버의 빈 훅 처리를 늘리는 것보다 여기서 멈추는 편이 낫다
[[ -z "${payload}" ]] && exit 0

# **브랜치는 모델이 아니라 git 이 말한다**(2026-09-03 · 사람 결정).
#
# 세션의 신원 3요소 중 branch·worktree 는 지금까지 `nerv_bootstrap` 인자로만 올 수 있었고,
# 모델이 그것을 실어 준 적이 없어 **실사용 세션 34개 전부 NULL** 이었다(실측). 훅은 프로젝트
# 디렉터리에서 돌므로 여기서 git 에게 직접 물으면 모델을 거치지 않는다.
#
# 두 자리에서만 묻는다 — 세션을 만드는 훅과 도구 훅이다. 앞은 처음 채우고 뒤는 신선하게
# 유지한다(브랜치는 세션 도중 바뀐다). 나머지 훅에서 git 을 부르는 것은 값 없는 비용이다.
extra=()
case "${endpoint}" in
  session | tool)
    if command -v git >/dev/null 2>&1; then
      ref="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
      # **detached HEAD 는 브랜치가 아니다.** 그대로 보내면 서로 다른 작업 수십 개가
      # 게이트 현황에서 "HEAD" 한 행으로 뭉친다 — 없는 것과 잘못된 것은 다르다.
      if [[ -n "${ref}" && "${ref}" != "HEAD" ]]; then
        extra+=(--header "X-NERV-Branch: ${ref}")
      fi
      top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
      [[ -n "${top}" ]] && extra+=(--header "X-NERV-Worktree: ${top}")
    fi
    ;;
esac

# 실패해도 0 으로 끝낸다 — 훅의 실패가 세션을 멈추면 텔레메트리가 조정 경로가 되어버린다.
response="$(curl --silent --show-error --max-time "${NERV_HOOK_TIMEOUT:-5}" \
  --request POST "${base}/ingest/hooks/${endpoint}" \
  --header "content-type: application/json" \
  --header "Authorization: Bearer ${NERV_TOKEN:-}" \
  --header "X-NERV-Project: ${NERV_PROJECT:-}" \
  --header "X-NERV-Host: ${NERV_HOSTNAME:-$(hostname -s 2>/dev/null || echo unknown)}" \
  --header "X-NERV-Agent: ${NERV_AGENT_TYPE:-claude-code}" \
  ${extra[@]+"${extra[@]}"} \
  --data "${payload}" 2>/dev/null || true)"

# **응답을 흘려보낸다**(2026-09-03). 예전에는 본문을 `/dev/null` 로 버렸다 — 그래서 이 경로를
# 쓰는 설치에서는 SessionStart 의 컨텍스트 주입도, Stop 의 `{"decision":"block"}` 도 모델에
# 도달하지 못했다. command 훅의 stdout 은 **JSON 이면 판정으로 읽힌다**(http 훅의 응답 본문과
# 같은 자리다). JSON 이 아닌 것은 내보내지 않는다: 프록시의 HTML 오류 페이지가 전사에 섞이면
# 사람이 그것을 훅의 말로 읽는다.
case "${response}" in
  '{'*) printf '%s' "${response}" ;;
esac

exit 0
