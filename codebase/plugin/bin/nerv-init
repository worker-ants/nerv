#!/usr/bin/env bash
# nerv-init — 작업 저장소에 NERV 설정 네 자리를 만든다 (plugin.md §3.7 · REQ-PLG-018 · 039)
#
# **왜 파일이 아니라 스크립트인가.** 서버 주소·토큰은 프로젝트마다 다른 값이라 여러
# 프로젝트가 공유하는 플러그인이 파일로 담을 수 없다(REQ-PLG-001 개정 · §3.3). 담을 수 없는
# 것과 손으로 만들어야 하는 것은 다르다 — 스크립트는 파일이 아니라 실행이라, 그 저장소
# 안에서 그 저장소의 값으로 쓴다. 훅이 플러그인에 남을 수 있는 이유와 같다.
#
# 네 자리를 만든다(Claude Code):
#   ① <저장소>/.mcp.json                    — MCP 접속 (§3.3 템플릿 그대로)
#   ② <저장소>/.claude/settings.local.json  — NERV_* 환경변수 (Claude Code 의 유일한 자리)
#   ③ <저장소>/.gitignore                   — `.nerv/` 무시 (REQ-PLG-013)
#   ④ <저장소>/AGENTS.md                    — 서버가 만든 본문의 NERV 구역 (§5.3 · REQ-PLG-039 · 2026-10-16)
#
# `--codex` 면 Codex 온보딩이다(2026-10-16 · E20-S04 · REQ-PLG-040). ①② 대신 이 둘을 만들고 ③④ 는 같다:
#   ①' <저장소>/.codex/config.toml          — MCP 접속 (§5.2 전문에 서버 주소 · 프로젝트를 채운다)
#   ②' <저장소>/.nerv/env                   — NERV_SERVER · NERV_PROJECT (훅 · notify 가 읽는다 · 토큰은 쓰지 않는다)
#
# **이미 있는 값은 덮지 않는다.** 빈 칸만 채우고, 값이 있으면 그대로 두고 말한다(JSON 은
# 다시 찍으므로 들여쓰기는 바뀔 수 있다 — 값과 키는 하나도 잃지 않는다). AGENTS.md 는 표시한 구역
# (`<!-- nerv:begin -->` ~ `<!-- nerv:end -->`)만 서버의 새 본문으로 바꾸고, 구역이 없는 파일은 덮지 않는다.
# 이 저장소는 그 반대를 한 번 해서 되살릴 수 없는 자격증명을 잃었다(AGENTS.md 규약 8 ·
# 2026-09-14). 설정 파일은 남의 작업이 들어 있는 자리다 — 설치 스크립트가 그것을 지우면
# 설치가 사고가 된다.
#
# 사용:
#   nerv-init [--dir <경로>] [--server <URL>] [--project <슬러그>] [--token <PAT>]
#   nerv-init --check    # 아무것도 쓰지 않고 상태만 말한다 (SessionStart 훅이 부른다 · AGENTS.md 가 낡았으면 한 줄)
#   nerv-init --codex [--server <URL>] [--project <슬러그>]   # Codex 온보딩 — 같은 규칙, 다른 두 자리
#
# Codex 의 훅이 부른 `--check` 는 `--codex` 를 주지 않아도 Codex 의 설정을 본다(포워더와 같은 판정 · 4.6 §5.4).
#
# 토큰은 인자로 주지 않으면 **가려서 묻는다**(TTY 일 때) — 셸 히스토리에 남기지 않으려고.
# 비대화형에서 값이 없으면 그 칸은 적지 않는다: 자리표시자를 적으면 "설정됐다" 고 보인다.
set -uo pipefail

default_server="https://api.nerv.example.com"

dir=""; server=""; project=""; token=""; mode="write"; codex="no"
while [ $# -gt 0 ]; do
  case "$1" in
    --dir) dir="${2:?--dir 뒤에 경로}"; shift 2 ;;
    --server) server="${2:?--server 뒤에 URL}"; shift 2 ;;
    --project) project="${2:?--project 뒤에 슬러그}"; shift 2 ;;
    --token) token="${2:?--token 뒤에 PAT}"; shift 2 ;;
    --check) mode="check"; shift ;;
    --codex) codex="yes"; shift ;;
    -h | --help) sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "nerv-init: 모르는 인자 $1 (--help)" >&2; exit 2 ;;
  esac
done

# 대상 저장소 — 훅에서 부를 때는 Claude Code 가 프로젝트 루트를 준다
root="${dir:-${CLAUDE_PROJECT_DIR:-$PWD}}"
if [ ! -d "$root" ]; then
  echo "nerv-init: 그런 디렉터리가 없다 — $root" >&2
  exit 2
fi
mcp="$root/.mcp.json"
settings="$root/.claude/settings.local.json"
ignore="$root/.gitignore"

# Codex 의 MCP 인증은 Codex 프로세스의 환경에서만 토큰을 읽는다(`bearer_token_env_var` · §3.3) — `.nerv/env` 를
# 읽기 **전의** 값을 따로 둔다. 그 파일의 토큰은 훅 포워더만 쓴다.
process_token="${NERV_TOKEN:-}"

# 프로젝트별 환경(.nerv/env) — Codex 폴백이지만 읽는 값은 같다(§3.3).
# **대상 저장소의 것을 읽는다** — 로더의 기본 경로는 cwd 상대라 `--dir` 로 남의 저장소를
# 가리켰을 때 엉뚱한 파일을 읽는다. 사람이 이미 정했으면 그것을 이긴다고 보지 않는다.
export NERV_ENV_FILE="${NERV_ENV_FILE:-$root/.nerv/env}"
. "$(dirname "${BASH_SOURCE[0]}")/nerv-env.sh"

# **누가 부르는가** — 포워더와 같은 판정이다(REQ-PLG-034): 사람이 정한 `NERV_AGENT_TYPE`, 아니면 Codex 가 플러그인
# 훅에만 주는 `PLUGIN_ROOT`(2026-10-16 실측). Codex 면 MCP 설정은 `.mcp.json` 이 아니라 `config.toml` 에 있다.
# 사람이 `--codex` 로 부르면 그것이 이긴다 — 셸에서 돌리는 온보딩에는 `PLUGIN_ROOT` 가 없다.
agent="${NERV_AGENT_TYPE:-}"
if [ -z "$agent" ]; then
  if [ -n "${PLUGIN_ROOT:-}" ]; then agent="codex"; else agent="claude-code"; fi
fi
[ "$codex" = "yes" ] && agent="codex"

# 사람에게 안내할 명령 — 세션 안의 훅이 부르면 그 세션의 플러그인 경로가 풀려 있다(§3.7)
init_cmd="\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-<플러그인 경로>}}/bin/nerv-init\""
[ "$agent" = "codex" ] && init_cmd="$init_cmd --codex"

# -- settings.local.json 의 env 읽기 -----------------------------------------
# JSON 은 셸로 읽지 않는다. node 도 python3 도 없으면 **읽지 못했다고 말하고** 환경변수만
# 본다 — 못 읽은 것을 "없다" 로 적으면 있는 값을 덮자고 권하게 된다.
runtime=""
if command -v node >/dev/null 2>&1; then runtime="node"
elif command -v python3 >/dev/null 2>&1; then runtime="python3"; fi

read_settings_env() { # <파일> → KEY=VALUE 줄들
  [ -f "$1" ] || return 0
  case "$runtime" in
    node) node -e '
const fs = require("fs");
const file = process.argv[1];
let doc = {};
try { doc = JSON.parse(fs.readFileSync(file, "utf8") || "{}"); } catch (e) { process.exit(0); }
const env = doc && doc.env;
if (env && typeof env === "object") {
  for (const key of Object.keys(env)) if (key.startsWith("NERV_")) console.log(key + "=" + env[key]);
}
' "$1" ;;
    python3) python3 -c '
import json, sys
try:
    doc = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    sys.exit(0)
env = doc.get("env") if isinstance(doc, dict) else None
if isinstance(env, dict):
    for key, value in env.items():
        if key.startswith("NERV_"):
            print(key + "=" + str(value))
' "$1" ;;
  esac
}

settings_server=""; settings_project=""; settings_token=""
while IFS='=' read -r key value; do
  case "$key" in
    NERV_SERVER) settings_server="$value" ;;
    NERV_PROJECT) settings_project="$value" ;;
    NERV_TOKEN) settings_token="$value" ;;
  esac
done < <(read_settings_env "$settings")

# 인자로 **명시한** 값 — 아래에서 파일의 값과 다르면 그 사실을 말한다
arg_server="$server"; arg_project="$project"; arg_token="$token"

# 값의 출처 — 인자 > 환경(관리형·셸·.nerv/env) > 이미 적힌 settings
pick() { for v in "$@"; do [ -n "$v" ] && { printf '%s' "$v"; return; }; done; }
server="$(pick "$server" "${NERV_SERVER:-}" "$settings_server")"
project="$(pick "$project" "${NERV_PROJECT:-}" "$settings_project")"
token="$(pick "$token" "${NERV_TOKEN:-}" "$settings_token")"

mcp_has_nerv() { [ -f "$mcp" ] && grep -q '"nerv"' "$mcp"; }

# Codex 의 MCP 서버 표 — 저장소의 `.codex/config.toml`(신뢰한 프로젝트에서만 읽힌다)이나 사용자 설정에 둔다.
# TOML 은 셸로 읽지 않고 표 이름 한 줄만 찾는다: `[mcp_servers.nerv]` 가 있으면 붙어 있다고 본다.
codex_user_config="${CODEX_HOME:-${HOME:-}/.codex}/config.toml"
codex_has_nerv() {
  for f in "$root/.codex/config.toml" "$codex_user_config"; do
    [ -f "$f" ] && grep -qE '^[[:space:]]*\[mcp_servers\.("nerv"|nerv)\][[:space:]]*(#.*)?$' "$f" && return 0
  done
  return 1
}

# -- AGENTS.md — 서버가 만든 본문의 구역 (§5.3 · REQ-PLG-039 · 2026-10-16 · 사람 결정 ①) -------------
#
# **서버가 본문을 만들고 이 스크립트가 구역만 바꾼다.** 서버는 저장소에 쓰지 않는다. 본문의 첫 줄과 끝 줄이 구역 표시다.
# 저장소의 AGENTS.md 는 사람이 쓴 규약이 사는 자리라(이 저장소 자신의 AGENTS.md 가 그렇다) 구역 밖은 한 바이트도
# 바꾸지 않는다. 구역이 없는 파일은 덮지 않는다 — `.mcp.json` 에 nerv 항목이 없을 때와 같은 규칙이다(덮지 않고 할 일을 말한다).
agents="$root/AGENTS.md"
agents_begin='<!-- nerv:begin'
agents_end='<!-- nerv:end'

# 저장소 AGENTS.md 의 구역 — none(파일 없음) · plain(구역 없음) · one(한 쌍) · broken(짝이 맞지 않음)
agents_state() {
  [ -f "$agents" ] || { echo none; return; }
  local b e bl el
  b="$(grep -c "^$agents_begin" "$agents")"
  e="$(grep -c "^$agents_end" "$agents")"
  if [ "$b" = 0 ] && [ "$e" = 0 ]; then echo plain; return; fi
  if [ "$b" = 1 ] && [ "$e" = 1 ]; then
    bl="$(grep -n "^$agents_begin" "$agents" | cut -d: -f1)"
    el="$(grep -n "^$agents_end" "$agents" | cut -d: -f1)"
    [ "$bl" -lt "$el" ] && { echo one; return; }
  fi
  echo broken
}

# 규약 버전 — 출처 줄의 `conventions@v<지문>`. 손으로 복사한 초안(`v<n>`)은 빈 값이다
agents_version_of() { grep -o 'conventions@v[0-9a-f]*' | head -n 1 | sed 's/^conventions@v//'; }
agents_region() { awk -v b="$agents_begin" -v e="$agents_end" 'index($0,b)==1{on=1} on{print} index($0,e)==1{on=0}' "$agents"; }

# 서버에서 본문을 받는다(EP-PRJ-06) — 상태 코드를 찍는다. 연결에 실패하면 000 이다
agents_fetch() { # <받을 파일> <시한 초>
  curl --silent --max-time "$2" --output "$1" --write-out '%{http_code}' \
    --header "Authorization: Bearer ${token}" \
    "${server%/}/api/v1/projects/${project}/agents-md" 2>/dev/null
}

# -- --check : 아무것도 쓰지 않는다 -------------------------------------------
#
# **쓰려는 흔적이 없으면 조용히 지나간다.** 플러그인은 기계에 하나라 NERV 와 무관한
# 저장소에서도 세션마다 돈다 — 거기서 설정을 재촉하면 그 줄은 곧 아무도 읽지 않는 줄이 된다.
#
# 저장소 안의 흔적은 포워더의 notify 와 같은 판정이다(`nerv_repo_configured` · nerv-env.sh · REQ-PLG-038). 여기서는 그 위에
# 기계 전체의 흔적(셸 환경 · 사용자 설정)과 `.nerv/` 폴더도 본다 — 안내는 말을 하는 쪽이라 넓게 보고, notify 는 내용을
# 내보내는 쪽이라 저장소의 설정만 본다.
if [ "$mode" = "check" ]; then
  trace="no"
  nerv_repo_configured "$root" && trace="yes"
  [ "$agent" = "codex" ] && codex_has_nerv && trace="yes"
  [ -d "$root/.nerv" ] && trace="yes"
  [ -n "$settings_server$settings_project$settings_token" ] && trace="yes"
  [ -n "${NERV_TOKEN:-}${NERV_PROJECT:-}" ] && trace="yes"
  [ "$(agents_state)" = "one" ] && trace="yes"
  [ "$trace" = "no" ] && exit 0

  # **AGENTS.md 가 낡았는가**(REQ-PLG-039). 구역이 있으면 서버의 규약 버전과 견준다 — 쓰지 않고 한 줄로만 알린다.
  # 세션 시작 훅의 시한(5초) 안에 끝나도록 2초만 기다린다. 서버에 이어지지 않거나 토큰이 없으면 말하지 않는다 — 판정할 수
  # 없는 것을 낡았다고 하지 않는다.
  stale=""
  if [ "$(agents_state)" = "one" ] && [ -n "$token" ] && [ -n "$project" ] && command -v curl >/dev/null 2>&1; then
    server="${server:-$default_server}"
    have="$(agents_region | agents_version_of)"
    fetched="$(mktemp "${TMPDIR:-/tmp}/nerv-agents.XXXXXX")"
    if [ "$(agents_fetch "$fetched" 2)" = "200" ]; then
      want="$(agents_version_of <"$fetched")"
      [ -n "$want" ] && [ "$want" != "$have" ] && stale="AGENTS.md 의 NERV 구역이 낡았다(conventions@v${have:-?} → v${want}) — 규약 스펙이 바뀌었다."
    fi
    rm -f "$fetched"
  fi

  missing=()
  if [ "$agent" = "codex" ]; then
    # **Codex 는 `.mcp.json` 을 읽지 않는다**(2026-10-15 실측 — 이 점검이 MCP 가 붙은 Codex 세션에 ".mcp.json 에 nerv 서버가
    # 없다" 고 알렸다). 토큰도 Codex 의 환경에서만 읽는다 — `.nerv/env` 에만 있으면 훅은 붙고 도구는 401 이다.
    codex_has_nerv || missing+=(".codex/config.toml(또는 ${codex_user_config})에 [mcp_servers.nerv] 가 없다 — NERV 도구가 이 세션에 붙지 않는다")
    [ -n "$process_token" ] || missing+=("NERV_TOKEN 이 Codex 의 환경에 없다 — 도구가 401 로 끝난다(.nerv/env 의 값은 MCP 인증에 쓰이지 않는다)")
    # config.toml 의 url 은 MCP 만 쓴다 — 훅과 notify 는 NERV_SERVER 를 읽고, 없으면 기본 주소로 간다(E20-S04)
    [ -n "$server" ] || missing+=("NERV_SERVER 가 비어 있다 — 훅과 notify 가 기본 주소(${default_server})로 간다(.nerv/env 에 둔다)")
    # Codex 는 규약을 AGENTS.md 로 읽는다. 사람이 쓴 AGENTS.md(구역 없음)는 사람의 선택이라 재촉하지 않는다
    [ "$(agents_state)" = "none" ] && missing+=("AGENTS.md 가 없다 — Codex 가 이 프로젝트의 NERV 규약을 모른다")
  else
    mcp_has_nerv || missing+=(".mcp.json 에 nerv 서버가 없다 — NERV 도구가 이 세션에 붙지 않는다")
    [ -n "$token" ] || missing+=("NERV_TOKEN 이 비어 있다 — 붙어도 401 로 끝난다")
  fi
  [ -n "$project" ] || missing+=("NERV_PROJECT 가 비어 있다")
  if [ ${#missing[@]} -eq 0 ]; then
    if [ -n "$stale" ]; then
      echo "$stale"
      echo "  사람에게 ${init_cmd} 를 다시 돌리라고 안내한다(구역만 바꾼다). 그때까지 규약은 nerv_bootstrap 의 conventions 로 읽는다."
    fi
    exit 0
  fi

  echo "NERV 설정이 덜 됐다:"
  for line in "${missing[@]}"; do echo "  - $line"; done
  echo "사람에게 이 명령을 안내한다(에이전트가 대신 실행하지 않는다 — 토큰을 묻는다):"
  echo "  ${init_cmd}"
  if [ "$agent" = "codex" ]; then
    # Codex 온보딩은 토큰을 파일에 쓰지 않는다 — MCP 인증이 프로세스 환경만 읽는다
    echo "  NERV_TOKEN 은 셸 환경변수로 둔 뒤 Codex 를 다시 띄운다(Codex 의 MCP 인증은 그 값만 읽는다)."
  fi
  echo "설정이 설 때까지 nerv_* 도구를 부르지 않는다 — 없는 도구를 부르면 승인 프롬프트만 쌓인다."
  [ -n "$stale" ] && echo "$stale"
  exit 0
fi

# -- 쓰기 ---------------------------------------------------------------------
[ -n "$server" ] || server="$default_server"
if [ -t 0 ]; then
  [ -n "$project" ] || { printf '프로젝트 슬러그(예: clemvion): '; read -r project; }
  if [ -z "$token" ]; then
    printf '에이전트 토큰(웹 설정 → 토큰 → 발급 · 화면에 찍지 않는다): '
    read -rs token; printf '\n'
  fi
fi

wrote=""; kept=""; show_mcp_entry="no"; show_codex_entry="no"
# bash 3.2 는 set -u 에서 빈 배열을 펴지 못한다 — 줄을 모아 두고 한 번에 찍는다
note_wrote() { wrote="${wrote}  썼다   ${1}\n"; }
note_kept() { kept="${kept}  그대로 ${1}\n"; }

# 인자로 준 값이 파일에 이미 있는 다른 값과 부딪치면 **파일이 이긴다** — 그리고 말한다.
conflict() { # <이름> <인자값> <파일값>
  [ -n "$2" ] && [ -n "$3" ] && [ "$2" != "$3" ] &&
    note_kept "settings.local.json 의 $1 — 인자와 다른 값이 이미 있다. 바꾸려면 그 파일을 직접 고친다"
  return 0
}

# -- Codex 온보딩의 두 자리 ①' ②' (2026-10-16 · E20-S04 · REQ-PLG-040) -----------------------------
#
# **새 명령이 아니라 같은 스크립트의 모드다.** 덮지 않는 규칙 · 값의 출처 · `--check` 가 같고, `.gitignore` 와 AGENTS.md 는
# 두 에이전트가 같은 자리를 쓴다. 다른 것은 MCP 설정과 환경의 자리뿐이다(Codex 는 `.mcp.json` · settings 를 읽지 않는다).
codex_config="$root/.codex/config.toml"
nerv_env="$root/.nerv/env"
# `.nerv/env` 에 이미 적힌 값 — 로더가 환경으로 올려 둔 값과 따로 읽어야 "파일이 이긴다" 를 판정한다
env_value() { [ -f "$nerv_env" ] && sed -n "s/^\(export \)\{0,1\}$1=//p" "$nerv_env" | tail -n 1 | sed "s/^[\"']//; s/[\"']\$//"; }

if [ "$agent" = "codex" ]; then
  file_server="$(env_value NERV_SERVER)"; file_project="$(env_value NERV_PROJECT)"
  for pair in "NERV_SERVER|$arg_server|$file_server" "NERV_PROJECT|$arg_project|$file_project"; do
    IFS='|' read -r key arg_value file_value <<<"$pair"
    [ -n "$arg_value" ] && [ -n "$file_value" ] && [ "$arg_value" != "$file_value" ] &&
      note_kept ".nerv/env 의 $key — 인자와 다른 값이 이미 있다. 바꾸려면 그 파일을 직접 고친다"
  done
  # 파일이 이긴다 — config.toml 도 같은 값으로 쓴다(두 파일이 다른 서버를 가리키지 않게)
  server="${file_server:-$server}"; project="${file_project:-$project}"

  # ①' .codex/config.toml — 없을 때만 쓴다(§5.2 전문). 있으면 한 줄도 건드리지 않는다.
  if [ -f "$codex_config" ]; then
    if grep -qE '^[[:space:]]*\[mcp_servers\.("nerv"|nerv)\][[:space:]]*(#.*)?$' "$codex_config"; then
      note_kept ".codex/config.toml — nerv 서버가 이미 있다"
    else
      note_kept ".codex/config.toml — 있지만 nerv 서버가 없다. 덮지 않았다 — 아래 표를 손으로 더한다"
      show_codex_entry="yes"
    fi
  elif [ -z "$project" ]; then
    note_kept ".codex/config.toml — 프로젝트가 없어 쓰지 않았다. --project 를 주고 다시 돌린다"
  elif printf '%s%s' "$server" "$project" | grep -q '["\\]'; then
    note_kept ".codex/config.toml — 서버 주소나 프로젝트에 따옴표 · 역슬래시가 있어 쓰지 않았다"
  else
    mkdir -p "$root/.codex"
    cat > "$codex_config" <<TOML
# <repo>/.codex/config.toml — NERV 온보딩 스크립트가 생성 · 저장소에 커밋
# 최상위 키는 표 이름([…]) 앞에 둔다 — 뒤에 두면 그 표의 키가 되어 Codex 가 무시한다(2026-10-16 실측)

# 사람 승인 레인 — A3 도구는 승인 없이 실행되지 않는다
approval_policy = "on-request"
sandbox_mode = "workspace-write"

[mcp_servers.nerv]
url = "${server%/}/mcp"
bearer_token_env_var = "NERV_TOKEN"
http_headers = { "X-NERV-Project" = "${project}" }
startup_timeout_sec = 20
# hostname 은 nerv_bootstrap 인자로 전달한다(헤더 확장에 의존하지 않는다)
TOML
    note_wrote ".codex/config.toml"
  fi

  # ②' .nerv/env — 훅 · notify 가 읽는 서버 주소와 프로젝트. 빈 칸만 채운다. **토큰은 쓰지 않는다** — Codex 의 MCP 인증은
  # 프로세스 환경만 읽어(§3.3) 파일의 토큰으로는 도구가 붙지 않고, 파일에 둔 토큰은 그 사실을 감춘다.
  env_added=""
  for pair in "NERV_SERVER|$server|$file_server" "NERV_PROJECT|$project|$file_project"; do
    IFS='|' read -r key value file_value <<<"$pair"
    [ -n "$file_value" ] || [ -z "$value" ] && continue
    if [ ! -f "$nerv_env" ]; then
      mkdir -p "$root/.nerv"
      printf '%s\n' "# NERV — 이 저장소의 서버와 프로젝트(nerv-init --codex · 4.6 §3.3). 토큰은 셸 환경변수 NERV_TOKEN 에 둔다." > "$nerv_env"
      chmod 600 "$nerv_env" 2>/dev/null
    fi
    [ -n "$(tail -c 1 "$nerv_env")" ] && printf '\n' >> "$nerv_env"
    printf '%s=%s\n' "$key" "$value" >> "$nerv_env"
    env_added="${env_added:+$env_added }$key"
  done
  [ -n "$env_added" ] && note_wrote ".nerv/env: $env_added" || note_kept ".nerv/env — 서버 주소와 프로젝트가 이미 있다"
fi

# ①② Claude Code 의 두 자리 — Codex 온보딩이면 건너뛴다(위 ①'②'). heredoc 이 있어 몸통을 들여쓰지 않는다.
if [ "$agent" != "codex" ]; then
conflict NERV_SERVER "$arg_server" "$settings_server"
conflict NERV_PROJECT "$arg_project" "$settings_project"
conflict NERV_TOKEN "$arg_token" "$settings_token"

# ① .mcp.json — 없을 때만 쓴다. 있으면 한 줄도 건드리지 않는다.
if [ -f "$mcp" ]; then
  if mcp_has_nerv; then note_kept ".mcp.json — nerv 서버가 이미 있다"
  else
    note_kept ".mcp.json — 있지만 nerv 서버가 없다. 덮지 않았다 — 아래 항목을 손으로 더한다"
    show_mcp_entry="yes"
  fi
else
  cat > "$mcp" <<'MCP'
{
  "mcpServers": {
    "nerv": {
      "type": "http",
      "url": "${NERV_SERVER:-https://api.nerv.example.com}/mcp",
      "headers": {
        "Authorization": "Bearer ${NERV_TOKEN}",
        "X-NERV-Project": "${NERV_PROJECT}"
      }
    }
  }
}
MCP
  note_wrote ".mcp.json"
fi

# ② .claude/settings.local.json — 빈 칸만 채운다(기존 키·값은 그대로)
if [ -z "$runtime" ]; then
  note_kept "settings.local.json — node 도 python3 도 없어 JSON 을 다루지 못했다. 아래 블록을 손으로 넣는다"
else
  mkdir -p "$root/.claude"
  pairs=("NERV_SERVER=$server")
  [ -n "$project" ] && pairs+=("NERV_PROJECT=$project")
  [ -n "$token" ] && pairs+=("NERV_TOKEN=$token")
  case "$runtime" in
    node) added="$(node -e '
const fs = require("fs");
const [file, ...pairs] = process.argv.slice(1);
let doc = {};
if (fs.existsSync(file)) {
  const raw = fs.readFileSync(file, "utf8").trim();
  if (raw !== "") {
    try { doc = JSON.parse(raw); } catch (e) { console.error("파싱 실패"); process.exit(3); }
  }
}
if (typeof doc !== "object" || doc === null || Array.isArray(doc)) { console.error("객체가 아니다"); process.exit(3); }
if (typeof doc.env !== "object" || doc.env === null || Array.isArray(doc.env)) doc.env = {};
const added = [];
for (const pair of pairs) {
  const at = pair.indexOf("=");
  const key = pair.slice(0, at);
  const value = pair.slice(at + 1);
  if (doc.env[key] !== undefined && doc.env[key] !== "") continue;
  doc.env[key] = value;
  added.push(key);
}
fs.writeFileSync(file, JSON.stringify(doc, null, 2) + "\n");
console.log(added.join(" "));
' "$settings" "${pairs[@]}")" ;;
    python3) added="$(python3 -c '
import json, os, sys
file = sys.argv[1]
doc = {}
if os.path.exists(file):
    raw = open(file, encoding="utf-8").read().strip()
    if raw:
        try:
            doc = json.loads(raw)
        except Exception:
            sys.stderr.write("파싱 실패")
            sys.exit(3)
if not isinstance(doc, dict):
    sys.stderr.write("객체가 아니다")
    sys.exit(3)
if not isinstance(doc.get("env"), dict):
    doc["env"] = {}
added = []
for pair in sys.argv[2:]:
    key, _, value = pair.partition("=")
    if doc["env"].get(key):
        continue
    doc["env"][key] = value
    added.append(key)
open(file, "w", encoding="utf-8").write(json.dumps(doc, ensure_ascii=False, indent=2) + "\n")
print(" ".join(added))
' "$settings" "${pairs[@]}")" ;;
  esac
  status=$?
  if [ $status -ne 0 ]; then
    note_kept "settings.local.json — 읽지 못하는 JSON 이라 건드리지 않았다. 사람이 본다"
  else
    # 토큰이 든다 — 남이 읽을 수 있는 채로 두지 않는다
    chmod 600 "$settings" 2>/dev/null
    [ -n "$added" ] && note_wrote "settings.local.json: $added" || note_kept "settings.local.json — 세 값이 이미 있다"
  fi
fi
fi # ①② 끝

# ③ .gitignore — `.nerv/` 한 줄 (REQ-PLG-013)
if [ -f "$ignore" ] && grep -qE '^\.nerv/?$' "$ignore"; then
  note_kept ".gitignore — .nerv/ 가 이미 있다"
else
  [ -f "$ignore" ] && [ -n "$(tail -c 1 "$ignore")" ] && printf '\n' >> "$ignore"
  printf '%s\n' '# NERV 플러그인 — 캐시·오프라인 큐·Codex 환경 파일' '.nerv/' >> "$ignore"
  note_wrote ".gitignore: .nerv/"
fi

# ④ AGENTS.md — 서버가 만든 본문(EP-PRJ-06)으로 만들거나 구역만 바꾼다(§5.3 · REQ-PLG-039)
show_agents_markers="no"
agents_note() { # 받지 못했으면 AGENTS.md 는 건드리지 않는다 — 자리표시자를 쓰면 "됐다" 고 보인다
  note_kept "AGENTS.md — $1. 건드리지 않았다 — 토큰과 서버를 맞춘 뒤 다시 돌리면 받는다"
}
state="$(agents_state)"
if [ "$state" = "plain" ]; then
  # 사람이 쓴 파일이다 — 받지도 않고 덮지도 않는다
  note_kept "AGENTS.md — 사람이 쓴 파일이고 NERV 구역이 없다. 덮지 않았다 — 구역을 둘 자리에 아래 두 줄을 넣고 다시 돌린다"
  show_agents_markers="yes"
elif [ "$state" = "broken" ]; then
  note_kept "AGENTS.md — NERV 구역 표시(<!-- nerv:begin --> · <!-- nerv:end -->)의 짝이 맞지 않는다. 건드리지 않았다 — 한 쌍만 남긴다"
elif [ -z "$token" ]; then
  agents_note "토큰이 없어 서버에서 본문을 받지 못했다"
elif [ -z "$project" ]; then
  agents_note "프로젝트가 없어 서버에서 본문을 받지 못했다"
elif ! command -v curl >/dev/null 2>&1; then
  agents_note "curl 이 없어 서버에서 본문을 받지 못했다"
else
  fetched="$(mktemp "${TMPDIR:-/tmp}/nerv-agents.XXXXXX")"
  code="$(agents_fetch "$fetched" 10)"
  if [ "$code" != "200" ] || [ "$(head -n 1 "$fetched")" != "<!-- nerv:begin -->" ]; then
    agents_note "서버에서 본문을 받지 못했다(${server%/} · HTTP ${code:-000})"
  else
    want="$(agents_version_of <"$fetched")"
    if [ "$state" = "none" ]; then
      cat "$fetched" > "$agents"
      note_wrote "AGENTS.md(conventions@v${want})"
    else
      have="$(agents_region | agents_version_of)"
      if [ -n "$want" ] && [ "$want" = "$have" ]; then
        note_kept "AGENTS.md — NERV 구역이 이미 최신이다(conventions@v${have})"
      else
        # 구역의 첫 줄에서 새 본문을 내보내고 끝 줄까지 건너뛴다 — 구역 밖의 줄은 그대로 지난다. 파일 끝의 줄바꿈도
        # 원래대로 둔다(awk 는 마지막 줄에 줄바꿈을 붙이므로 한 줄씩 늦게 내보낸다)
        nl="no"
        [ -z "$(tail -c 1 "$agents")" ] && nl="yes"
        spliced="$(mktemp "${TMPDIR:-/tmp}/nerv-agents.XXXXXX")"
        awk -v b="$agents_begin" -v e="$agents_end" -v body="$fetched" -v nl="$nl" '
          function out(s) { if (have) print prev; prev = s; have = 1 }
          index($0, b) == 1 { while ((getline line < body) > 0) out(line); skip = 1; next }
          skip && index($0, e) == 1 { skip = 0; next }
          !skip { out($0) }
          END { if (have) { if (nl == "yes") print prev; else printf "%s", prev } }
        ' "$agents" > "$spliced" && cat "$spliced" > "$agents"
        rm -f "$spliced"
        note_wrote "AGENTS.md — NERV 구역만 바꿨다(conventions@v${have:-?} → v${want})"
      fi
    fi
  fi
  rm -f "$fetched"
fi

echo "NERV 설정 — $root"
printf %b "$wrote" "$kept"
if [ "$show_mcp_entry" = "yes" ]; then
  echo
  echo "$mcp 의 mcpServers 에 더할 항목:"
  cat <<'ENTRY'
    "nerv": {
      "type": "http",
      "url": "${NERV_SERVER:-https://api.nerv.example.com}/mcp",
      "headers": {
        "Authorization": "Bearer ${NERV_TOKEN}",
        "X-NERV-Project": "${NERV_PROJECT}"
      }
    }
ENTRY
fi
if [ "$show_codex_entry" = "yes" ]; then
  echo
  echo "$codex_config 에 더할 표(approval_policy · sandbox_mode 가 없으면 표 이름보다 앞에 둔다):"
  cat <<ENTRY
[mcp_servers.nerv]
url = "${server%/}/mcp"
bearer_token_env_var = "NERV_TOKEN"
http_headers = { "X-NERV-Project" = "${project:-<프로젝트 슬러그>}" }
startup_timeout_sec = 20
ENTRY
fi
if [ "$show_agents_markers" = "yes" ]; then
  echo
  echo "$agents 에서 NERV 구역을 둘 자리에 넣을 두 줄(그 사이를 nerv-init 이 채우고 바꾼다):"
  echo "<!-- nerv:begin -->"
  echo "<!-- nerv:end -->"
fi
if [ "$agent" = "codex" ]; then
  if [ -z "$process_token" ]; then
    echo
    echo "NERV_TOKEN 이 셸 환경에 없다 — Codex 의 MCP 인증은 셸 환경의 값만 읽는다. 파일에는 쓰지 않았다."
    echo "셸 프로필이나 시크릿 매니저로 둔다(웹 설정 → 토큰 → 발급 · 값은 그때 한 번만 보인다)."
  fi
  # 턴 완료 알림은 사용자 설정에만 둘 수 있다(§5.2) — 이 명령은 저장소 밖에 쓰지 않으므로 넣을 줄만 보여 준다
  if ! { [ -f "$codex_user_config" ] && grep -q 'nerv-hook-forward' "$codex_user_config"; }; then
    notify_line="$(sed -n 's/^# \(notify = \[.*\)$/\1/p' "$(dirname "${BASH_SOURCE[0]}")/../codex/config.toml" 2>/dev/null | head -n 1)"
    if [ -n "$notify_line" ]; then
      echo
      echo "선택 — 턴 완료 알림(notify)을 세션 화면에 남기려면 ${codex_user_config} 의 맨 위(표 이름 앞)에 이 줄을 둔다."
      echo "사용자 설정이라 이 명령은 쓰지 않는다. NERV 를 설정한 저장소의 턴만 보낸다(4.6 §5.2):"
      echo "$notify_line"
    fi
  fi
  echo
  echo "다음: 이 저장소에서 Codex 를 다시 띄우고 프로젝트를 신뢰한다(저장소의 .codex/config.toml 은 신뢰한 프로젝트에서만 읽힌다)."
  echo "플러그인을 설치했다면 /hooks 에서 NERV 훅을 신뢰 처리한다. 그다음 nerv_bootstrap."
else
  if [ -z "$token" ]; then
    echo
    echo "토큰이 없다 — NERV_TOKEN 을 settings.local.json 의 env 에 넣어야 붙는다."
    echo "웹 설정 → 토큰 → 발급(값은 그때 한 번만 보인다) 뒤 다시 이 명령을 돌리면 빈 칸만 찬다."
  fi
  echo
  echo "다음: Claude Code 를 다시 띄우고 /mcp 에서 nerv 가 connected 인지 본다. 그다음 /nerv:next."
fi
