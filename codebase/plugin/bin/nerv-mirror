#!/bin/sh
# nerv-mirror — 스펙 문서와 첨부를 로컬 폴더에 미러한다 (plugin.md §2.7 · REQ-PLG-028)
#
# 본체는 `skills/mirror/scripts/nerv-mirror.mjs` 다. 이 파일은 PATH 에 들어가는 이름만 맡는다 — 스킬의
# `allowed-tools` 가 `Bash(nerv-mirror:*)` 하나로 끝나게 하고, node 가 없을 때 할 일을 알린다.

root="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"

if ! command -v node >/dev/null 2>&1; then
  echo "실패  node가 없다 — nerv-mirror는 node 18 이상으로 돈다" >&2
  echo "다음  node 를 설치하고 다시 실행한다" >&2
  exit 1
fi

exec node "$root/skills/mirror/scripts/nerv-mirror.mjs" "$@"
